diff --git a/utilities/Icon17to16converter.py b/utilities/Icon17to16converter.py
new file mode 100644
index 000000000..c14d39d47
--- /dev/null
+++ b/utilities/Icon17to16converter.py
@@ -0,0 +1,14 @@
+from PIL import Image
+
+# Converts a 17x17 arrangement of 16x16 icons to 16x16
+
+fn = 'ArchaneaIconProject-BG_2019.png'
+img = Image.open(fn)
+width, height = img.size
+new_img = Image.new('RGB', (width, height))
+for x in range(width // 18):
+    for y in range(height // 18):
+        i, j = x * 18 + 2, y * 18 + 2
+        cropped = img.crop((i, j, i + 16, j + 16))
+        new_img.paste(cropped, (x * 16, y * 16))
+new_img.save(fn[:-4] + '_new.png')
diff --git a/utilities/animation_notes.txt b/utilities/animation_notes.txt
new file mode 100644
index 000000000..02c44c59d
--- /dev/null
+++ b/utilities/animation_notes.txt
@@ -0,0 +1,102 @@
+Thoughts on Sprite and Sprite Effect Refactor
+
+All of these effects can be animated ("Tweened") over time:
+    - Move Sprite (unit sprite, sprite set)
+        - Also vibrations of sprite
+    - Fade transparency (unit sprite, sprite set)
+    - Color Changes (unit sprite, sprite set)
+        - Additive blend
+        - Set color exactly
+        - Subtractive blend
+        - Tints in general
+    - Scaling effects (unit sprite, sprite set)
+    - Changing the sprite's current image itself
+
+- What can add these:
+    - Lots of stuff, including basic things like player-directed movement
+    - Combat Playbacks
+    - Skills
+    - Event calls
+
+Instead of calling MapAnimations "Animations"/"MapAnimations" we call them SpriteSets
+
+SpriteSets are things like a specific unit sprite animation, poison anim over the units head, talk icon over the units head, boss icon, Level Up animation on map, miss words animation on map, healing animation on map, Level Up animation in an AnimationCombat, Miss words animation in an AnimationCombat, etc.
+Some of these loop, some don't.
+Basically, anytime a set of >=1 sprites are shown in specific order on the screen or change over time and they are present:
+    - On a unit sprite
+    - On a map position
+    - In global screen space (for combat, for instance)
+
+UnitSprites will be refactored to contain collections of SpriteSets (passive SpriteSet, active/focus SpriteSet, move right SpriteSet, move up SpriteSet etc.) (This would be a significant refactor!)
+
+Tweens can be applied to a SpriteSet to modify the SpriteSet (make a SpriteSet gray, make translucent, scale, etc.)
+
+TweenSequences are collections of Tweens that can operate upon SpriteSets.
+
+We would completely remove the current Animation and MapAnimation implementations
+
+**SpriteSetPrefab API**
+nid: str
+full_path: str
+pixmap: QPixmap
+frame_x, frame_y: int (how the images are packed)
+num_frames: int (total number of images)
+
+**SpriteSet API**
+nid: str
+images: List[pygame.Surface]
+idx: int
+current_image: pygame.Surface @property
+def draw(surf)
+
+**TweenSequence API**
+timeline: Dict[int: AnimationEffect] # key: starting frame num, value: Tween
+current_frame: int  # Dynamic
+last_frame: int  # Static
+loop: bool
+add(tween, with_delay=False)
+add_delay(int)  # Num frames
+
+**Tween API**
+sprite_set: SpriteSet (that is operated upon)
+?? otherwise varies significantly
+
+Tween -> the basic operation
+TweenSequences are only necessary when things must be done in a certain order
+
+sequence = TweenSequence(loop=True)
+sequence.add(AlphaFadeTween(sprite_set, a=0.0, frames=20, curve=Quad))
+sequence.add_delay(10)
+sequence.add(Vibrate(sprite_set, direction=(1, 0)))
+
+sequence = TweenSequence()
+sequence.add(AlphaFadeTween(sprite_set), with_delay=True)
+sequence.add(Vibrate(sprite_set, direction=(1, 0)))
+
+Tweens are kept in a separate tween module, that can just be globally accessed (separation of Tween and SpriteSet (func and data))
+
+# Example Tweens
+
+AlphaFadeTween(sprite_set, target_alpha: float, num_frames: int, curve: Curve = Linear)
+
+MovementTween(sprite_set, target_pos: (x, y), num_frames: int, curve: Curve = Linear)
+
+AnimateTween(sprite_set, speed: int, reverse: bool = False)  # Actually updates the sprite_set's current image
+
+TintTween(sprite_set, target_tint: (r, g, b), num_frames: int, curve: Curve = Linear)
+
+VibrateTween(sprite_set, magnitude: (x, y), num_frames: int)  # Yes, this could be done with a TweenSequence of several MovementTweens
+
+# What do Curves look like? 
+For now, Linear (lerp), Quadratic, Cubic, maybe Sin
+
+# Remaining questions - What owns Tweens and TweenSequences?
+ - Auto-register tweens with a static system in the tween module that updates them? As long as you keep a handle to the tween, you can kill it later...
+ - Force all tweens to places themselves with a TweenSpawner/TweenController/"just plain list" that keeps track of their lifetimes and runs their update funcs. Objects or states will need to run the TweenController's update func that updates all the individual tweens, and removes the dead ones. (I prefer this one better, I think)
+
+# Particle Systems
+ParticleSystems are hopefully self-explanatory
+Some ParticleSystems last forever, some don't
+    - on a sprite set (uses Tweens),
+    - on a map position
+    - global screen space (for weather)
diff --git a/utilities/archived_code/value_noise_generator.py b/utilities/archived_code/value_noise_generator.py
new file mode 100644
index 000000000..3d1be749a
--- /dev/null
+++ b/utilities/archived_code/value_noise_generator.py
@@ -0,0 +1,100 @@
+import random, math
+
+from PIL import Image
+
+class ValueNoise():
+    num_octaves = 5
+    pixels_per_lattice = 24
+    pixel_depth = 48 * 4
+
+    def __init__(self, width: int, height: int):
+        self.pixel_width = width
+        self.pixel_height = height
+        self.lattice_width = width // self.pixels_per_lattice
+        self.lattice_height = height // self.pixels_per_lattice
+        self.lattice_depth = self.pixel_depth // self.pixels_per_lattice
+        self.lattice_depth //= 4
+
+        self.noise_map = self.generate_full_noise_map()
+
+    def generate_full_noise_map(self):
+        frequency = 0.25
+        frequency_mult = 2  # lacunarity
+        amplitude_mult = 0.35
+        amplitude = 1
+        true_noise_map = [0 for _ in range(self.pixel_width * self.pixel_height * self.pixel_depth)]
+        for i in range(self.num_octaves):
+            print("Octave: %d" % i)
+            noise_map = self.generate_noise_map(frequency)
+            noise_map = [v * amplitude for v in noise_map]
+            amplitude *= amplitude_mult
+            frequency *= frequency_mult
+            true_noise_map = [n + tn for n, tn in zip(noise_map, true_noise_map)]
+        # normalize map
+        max_value = max(true_noise_map)
+        true_noise_map = [v / max_value for v in true_noise_map]
+        return true_noise_map
+
+    def _interp(self, a, b, t):
+        # t should be in range 0 to 1
+        remap_t = t * t * (3 - 2 * t)
+        return a * (1 - remap_t) + b * remap_t
+
+    def generate_noise_map(self, frequency):
+        randoms = [random.random() for _ in range(self.lattice_width * self.lattice_height * self.lattice_depth)]
+        noise_map = []
+        for pz in range(self.pixel_depth):
+            print(pz)
+            for px in range(self.pixel_width):
+                for py in range(self.pixel_height):
+                    lx = px * frequency / self.pixels_per_lattice
+                    ly = py * frequency / self.pixels_per_lattice
+                    lz = pz * frequency / self.pixels_per_lattice
+                    lx %= self.lattice_width
+                    ly %= self.lattice_height
+                    lz %= self.lattice_depth
+                    flx = math.floor(lx)
+                    fly = math.floor(ly)
+                    flz = math.floor(lz)
+                    tx = lx - flx
+                    ty = ly - fly
+                    tz = lz - flz
+                    rx0 = flx
+                    rx1 = (flx + 1) % self.lattice_width
+                    ry0 = fly
+                    ry1 = (fly + 1) % self.lattice_height
+                    rz0 = flz
+                    rz1 = (flz + 1) % self.lattice_depth
+                    c000 = randoms[rz0 * self.lattice_width * self.lattice_height + rx0 * self.lattice_height + ry0]
+                    c010 = randoms[rz0 * self.lattice_width * self.lattice_height + rx0 * self.lattice_height + ry1]
+                    c001 = randoms[rz0 * self.lattice_width * self.lattice_height + rx1 * self.lattice_height + ry0]
+                    c011 = randoms[rz0 * self.lattice_width * self.lattice_height + rx1 * self.lattice_height + ry1]
+                    c100 = randoms[rz1 * self.lattice_width * self.lattice_height + rx0 * self.lattice_height + ry0]
+                    c110 = randoms[rz1 * self.lattice_width * self.lattice_height + rx0 * self.lattice_height + ry1]
+                    c101 = randoms[rz1 * self.lattice_width * self.lattice_height + rx1 * self.lattice_height + ry0]
+                    c111 = randoms[rz1 * self.lattice_width * self.lattice_height + rx1 * self.lattice_height + ry1]
+                    nx00 = self._interp(c000, c001, tx)
+                    nx01 = self._interp(c010, c011, tx)
+                    nx10 = self._interp(c100, c101, tx)
+                    nx11 = self._interp(c110, c111, tx)
+                    ny0 = self._interp(nx00, nx01, ty)
+                    ny1 = self._interp(nx10, nx11, ty)
+                    final = self._interp(ny0, ny1, tz)
+                    # print("px:%d py:%d %.2f %.2f %d %d %d %d tx:%.2f ty:%.2f c00:%.2f c10:%.2f c01:%.2f c11:%.2f f:%.2f" % (px, py, lx, ly, rx0, rx1, ry0, ry1, tx, ty, c00, c10, c01, c11, final))
+                    noise_map.append(final)
+        return noise_map
+
+    def noise_map_to_pillow(self, noise_map, pz):
+        new_image = Image.new('RGB', (self.pixel_width, self.pixel_height))
+        for px in range(self.pixel_width):
+            for py in range(self.pixel_height):
+                noise_value = int(255 * noise_map[pz * self.pixel_width * self.pixel_height + px * self.pixel_height + py])
+                new_image.putpixel((px, py), (noise_value, noise_value, noise_value))
+        new_image.save("im%03d.png" % pz)
+
+    def save_img(self):
+        for pz in range(self.pixel_depth):
+            self.noise_map_to_pillow(self.noise_map, pz)
+
+VALUE_NOISE = ValueNoise(384, 216)
+VALUE_NOISE.save_img()
diff --git a/utilities/archived_code/west_march/fog_particles.py b/utilities/archived_code/west_march/fog_particles.py
new file mode 100644
index 000000000..067ae51c2
--- /dev/null
+++ b/utilities/archived_code/west_march/fog_particles.py
@@ -0,0 +1,99 @@
+import math, random
+
+from dataclasses import dataclass
+
+from app.constants import TILEWIDTH, TILEHEIGHT
+from app.engine.sprites import SPRITES
+
+from app.engine import engine, image_mods
+from app.engine.game_state import game
+from app.utilities import utils
+
+@dataclass
+class FogParticle():
+    x: float = 0
+    y: float = 0
+    x_speed: float = 0
+    y_speed: float = 0
+    size: int = 0
+    transparency: float = 0
+    time_offset: float = 0
+
+class FogParticleSystem():
+    def __init__(self, nid, abundance, bounds, size, position=None):
+        width, height = size
+        self.nid = nid
+        self.pos = position
+        self.abundance = int(abundance * width * height)
+        self.particles = []
+        self.remove_me_flag = False
+
+        self.lx, self.ux, self.ly, self.uy = bounds
+
+        # Build sprites
+        _fog_sprite = SPRITES.get('particle_fog_mote')
+        _fog_sprites = [engine.subsurface(_fog_sprite, (0, 0, 3, 3)),
+                        engine.subsurface(_fog_sprite, (3 + 1, 0, 5, 5)),
+                        engine.subsurface(_fog_sprite, (8 + 2, 0, 7, 7)),
+                        engine.subsurface(_fog_sprite, (15 + 3, 0, 9, 9)),
+                        engine.subsurface(_fog_sprite, (24 + 4, 0, 11, 11))]
+        self.transparencies = []
+        for sprite in _fog_sprites:
+            self.transparencies.append([image_mods.make_translucent(sprite, k) for k in (0.9, 0.92, 0.94, 0.96, 0.98, 1.0)])
+    
+    def save(self):
+        return self.nid
+
+    def add_particle(self, x, y):
+        transparency = .8
+        time_offset = random.randrange(0, 100) * 100
+        size = random.randrange(0, 5)
+        speed = utils.clamp(random.normalvariate(1, .5), 0.1, 5)
+        angle = random.uniform(315, 359) * math.pi / 180
+        x_speed = speed * (2.5 - size/2) * math.cos(angle)
+        y_speed = speed * (2.5 - size/2) * math.sin(angle)
+        new_particle = FogParticle(x, y, x_speed, y_speed, size, transparency, time_offset)
+        return new_particle
+        
+    def update(self):
+        current_time = engine.get_time()
+
+        for particle in self.particles:
+            particle.x += particle.x_speed
+            particle.y -= particle.y_speed
+            t_offset = math.sin((current_time + particle.time_offset) / 500)
+            particle.transparency = .95 + 0.1 * t_offset
+
+        # Remove particles that have left the map
+        self.particles = [p for p in self.particles if (p.x < game.tilemap.width * TILEWIDTH and p.y < game.tilemap.height * TILEHEIGHT)]
+
+        if len(self.particles) < self.abundance:
+            xpos = random.randint(self.lx, self.ux)
+            ypos = random.randint(self.ly, self.uy)
+            new_particle = self.add_particle(xpos, ypos)
+            self.particles.append(new_particle)
+
+        if self.abundance <= 0 and not self.particles:
+            self.remove_me_flag = True
+
+    def prefill(self):
+        for _ in range(300):
+            self.update()
+
+    def draw(self, surf, offset_x=0, offset_y=0):
+        for particle in self.particles:
+            closest_transparency = utils.clamp(particle.transparency, 0.9, 1.0)
+            if 0.9 <= closest_transparency < 0.91:
+                idx = 0
+            elif 0.91 <= closest_transparency < 0.93:
+                idx = 1
+            elif 0.93 <= closest_transparency < 0.95:
+                idx = 2
+            elif 0.95 <= closest_transparency < 0.97:
+                idx = 3
+            elif 0.97 <= closest_transparency < 0.99:
+                idx = 4
+            else:
+                idx = 5
+            sprite = self.transparencies[particle.size][idx]
+            surf.blit(sprite, (particle.x - offset_x, particle.y - offset_y))
diff --git a/utilities/archived_code/west_march/hex_board.py b/utilities/archived_code/west_march/hex_board.py
new file mode 100644
index 000000000..17a5e98d2
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_board.py
@@ -0,0 +1,215 @@
+import heapq
+
+from enum import Enum
+from typing import Dict, List, Tuple, TYPE_CHECKING
+
+# if TYPE_CHECKING:
+from app.constants import TILEWIDTH, TILEHEIGHT
+from app.data.hex_prefab import HexPrefab
+from app.data.hex_type import HexType
+
+from app.utilities import hex_math
+from app.utilities.typing import NID
+from app.data.overworld import OverworldPrefab
+
+from app.data.database import DB
+
+
+class Sight(Enum):
+    UNEXPLORED = 0
+    EXPLORED = 1
+    INSIGHT = 2
+
+class HexData():
+    def __init__(self, pos, sight=Sight.UNEXPLORED):
+        self.pos: hex_math.Hex = pos
+        self.adjacency: List[hex_math.Hex] = []
+        self.sight: Sight = sight
+
+    @property
+    def pixel_pos(self) -> tuple:
+        # Returns pixel position
+        return hex_math.hex_to_pixel(self.pos)
+
+    @property
+    def position(self):
+        return self.pixel_pos[0] / TILEWIDTH, self.pixel_pos[1] / TILEHEIGHT
+
+    def save(self):
+        return (self.pos, self.sight)
+
+    @classmethod
+    def restore(cls, dat):
+        pos = tuple(dat[0])
+        return cls(pos, dat[1])
+
+class HexBoard():
+    def __init__(self, overworld_prefab: OverworldPrefab):
+        self.hexes: Dict[hex_math.Hex, HexPrefab] = overworld_prefab.hexes.copy()
+
+        self.hex_graph = {}  # Store Hex Data
+        for hex_prefab in self.hexes.values():
+            hex_data = HexData(hex_prefab.pos)
+            self.hex_graph[hex_data.pos] = hex_data
+
+        self.assign_adjacency()
+
+    def assign_adjacency(self):
+        for hex_data in self.hex_graph.values():
+            potential_neighbors: List[hex_math.Hex] = hex_math.get_neighbors(hex_data.pos)
+            for neighbor in potential_neighbors:
+                if neighbor in self.hex_graph:
+                    hex_data.adjacency.append(neighbor)
+
+    def save(self):
+        return [h.save() for h in self.hex_graph.values()]
+
+    def restore(self, hex_graph_data):
+        self.hex_graph.clear()
+        for dat in hex_graph_data:
+            hex_data = HexData.restore(dat)
+            self.hex_graph[hex_data.pos] = hex_data
+
+        self.assign_adjacency()
+
+    def get_hex_type(self, pos) -> HexType:
+        hex_prefab = self.hexes.get(pos)
+        if hex_prefab:
+            return hex_prefab.hex_type
+        return None
+
+    def get_name(self, pos) -> str:
+        hex_prefab = self.hexes.get(pos)
+        if hex_prefab:
+            if hex_prefab.name:
+                return hex_prefab.name
+            elif DB.hex_types.get(hex_prefab.hex_type):
+                return DB.hex_types.get(hex_prefab.hex_type).name
+        return ''
+
+    def get_mcost(self, pos) -> float:
+        hex_type_nid = self.get_hex_type(pos)
+        hex_type = DB.hex_types.get(hex_type_nid)
+        if hex_type:
+            return hex_type.movement_cost
+        return 1
+
+    def get_adj(self, pos) -> List[hex_math.Hex]:
+        hex_data = self.hex_graph.get(pos)
+        if hex_data:
+            return hex_data.adjacency
+        return []
+
+    def get_sight(self, pos) -> Sight:
+        hex_data = self.hex_graph.get(pos)
+        if hex_data:
+            return hex_data.sight
+        return Sight.UNEXPLORED
+
+    def _update_fow(self, pos: hex_math.Hex, sight_range: int, new_sight: Sight):
+        positions_in_range: List[hex_math.Hex] = hex_math.get_all_hex_within_distance(pos, sight_range)
+        for hex_pos in positions_in_range:
+            hex_data = self.hex_graph.get(hex_pos)
+            if hex_data:
+                hex_data.sight = new_sight
+
+    def fow_leave(self, pos: hex_math.Hex, sight_range: int = 2):
+        self._update_fow(pos, sight_range, Sight.EXPLORED)
+        
+    def fow_arrive(self, pos: hex_math.Hex, sight_range: int = 2):
+        self._update_fow(pos, sight_range, Sight.INSIGHT)
+
+    def has_path(self, a: hex_math.Hex, b: hex_math.Hex, only_visible=False) -> bool:
+        """
+        Returns whether there is a path between two hexes
+        """
+        pathfinding = HexPathfinding(self, b)
+        path = pathfinding.process_astar(a, only_visible)
+        if path:
+            return True
+        return False
+
+    def shortest_path(self, a: hex_math.Hex, b: hex_math.Hex, only_visible=False) -> List[hex_math.Hex]:
+        """
+        Returns the shortest path between the two hexes
+        """
+        pathfinding = HexPathfinding(self, b)
+        return pathfinding.process_astar(a, only_visible)
+
+class HexPathfinding():
+    def __init__(self, hex_board: HexBoard, end: hex_math.Hex):
+        self.hex_board = hex_board
+        self.heuristic_data: Dict[hex_math.Hex, tuple] = {} # Dictionary that contains heuristic data
+        self.parent_data: Dict[hex_math.Hex, hex_math.Hex] = {}  # Dictionary that contians parent data for each hex
+
+        self.open = []
+        self.closed = set()
+
+        self.end = end
+
+    def reset(self):
+        self.heuristic_data.clear()
+        self.parent_data.clear()
+        for hex_pos in self.hex_board.hex_graph:
+            self.heuristic_data[hex_pos] = [0, 0, 0]
+            self.parent_data[hex_pos] = None
+
+        self.open = []
+        heapq.heapify(self.open)
+        self.closed.clear()
+
+    def get_heuristic(self, pos: hex_math.Hex) -> float:
+        return hex_math.calculate_distance(pos, self.end)
+
+    def update_hex(self, adj: hex_math.Hex, pos: hex_math.Hex):
+        pos_g = self.heuristic_data[pos][1]
+        adj_g = pos_g + self.hex_board.get_mcost(adj)
+        self.heuristic_data[adj][1] = adj_g
+        adj_h = self.get_heuristic(adj)
+        self.heuristic_data[adj][2] = adj_h
+        adj_f = adj_g + adj_h
+        self.heuristic_data[adj][0] = adj_f
+        # Update parent
+        self.parent_data[adj] = pos
+
+    def return_path(self, pos: hex_math.Hex) -> List[hex_math.Hex]:
+        path = []
+        while pos:
+            path.append(pos)
+            pos = self.parent_data.get(pos)
+        return path
+
+    def process_astar(self, start: hex_math.Hex, only_visible=False) -> List[hex_math.Hex]:
+        self.reset()
+        start_f = self.heuristic_data[start][0]
+        heapq.heappush(self.open, (start_f, start))
+        while self.open:
+            f, pos = heapq.heappop(self.open)
+            # Don't process the hex twice
+            self.closed.add(pos)
+            # If ending cell, return path
+            if pos == self.end:
+                return self.return_path(pos)
+            # Get adjacent hexes for hexes
+            if only_visible:
+                adj_hexes = [adj for adj in self.hex_board.get_adj(pos) if self.hex_board.get_sight(adj) in (Sight.INSIGHT, Sight.EXPLORED)]
+            else:
+                adj_hexes = [adj for adj in self.hex_board.get_adj(pos)]
+            for adj in adj_hexes:
+                if self.hex_board.get_mcost(adj) < 99 and adj not in self.closed:
+                    adj_f = self.heuristic_data[adj][0] 
+                    if (adj_f, adj) in self.open:
+                        adj_g = self.heuristic_data[adj][1]
+                        cur_g = self.heuristic_data[pos][1]
+                        # check if current path is beter than the one previous found for this adj
+                        if adj_g > cur_g + self.hex_board.get_mcost(adj):
+                            self.update_hex(adj, pos)
+                            adj_f = self.heuristic_data[adj][0] 
+                            heapq.heappush(self.open, (adj_f, adj))
+                    else:
+                        self.update_hex(adj, pos)
+                        adj_f = self.heuristic_data[adj][0] 
+                        heapq.heappush(self.open, (adj_f, adj))
+                else:
+                    pass  # Cannot move to here
+        return []
diff --git a/utilities/archived_code/west_march/hex_editor/hex_event_delegate.py b/utilities/archived_code/west_march/hex_editor/hex_event_delegate.py
new file mode 100644
index 000000000..5d2cd9864
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_editor/hex_event_delegate.py
@@ -0,0 +1,26 @@
+from PyQt5.QtWidgets import QDoubleSpinBox, QItemDelegate
+
+from app.data.database import DB
+
+from app.extensions.custom_gui import ComboBox
+
+class HexEventDelegate(QItemDelegate):
+    event_column = 0
+    float_column = 1
+
+    def createEditor(self, parent, option, index):
+        print("Create Editor")
+        if index.column() == self.event_column:
+            editor = ComboBox(parent)
+            for event in DB.events:
+                if not event.level_nid and not event.trigger:
+                    editor.addItem(event.nid)
+            return editor
+            return editor
+        elif index.column() == self.float_column:
+            editor = QDoubleSpinBox(parent)
+            editor.setRange(0, 20)
+            editor.setSingleStep(0.1)
+            return editor
+        else:
+            return super().createEditor(parent, option, index)
diff --git a/utilities/archived_code/west_march/hex_editor/hex_type_model.py b/utilities/archived_code/west_march/hex_editor/hex_type_model.py
new file mode 100644
index 000000000..7d2b41f2a
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_editor/hex_type_model.py
@@ -0,0 +1,32 @@
+from PyQt5.QtGui import QIcon, QPixmap, QColor
+from PyQt5.QtCore import Qt
+
+from app.data.database import DB
+
+from app.editor.base_database_gui import DragDropCollectionModel
+from app.utilities import str_utils
+
+from app.data import hex_type
+
+class HexTypeModel(DragDropCollectionModel):
+    def data(self, index, role):
+        if not index.isValid():
+            return None
+        if role == Qt.DisplayRole:
+            hex_type = self._data[index.row()]
+            text = hex_type.nid
+            return text
+        elif role == Qt.DecorationRole:
+            hex_type = self._data[index.row()]
+            color = hex_type.color
+            pixmap = QPixmap(32, 32)
+            pixmap.fill(QColor(color[0], color[1], color[2]))
+            return QIcon(pixmap)
+        return None
+
+    def create_new(self):
+        nids = [d.nid for d in self._data]
+        nid = name = str_utils.get_next_name("New Hex Type", nids)
+        new_hex_type = hex_type.HexType(nid, name, (0, 0, 0), 1, [])
+        DB.hex_types.append(new_hex_type)
+        return new_hex_type
diff --git a/utilities/archived_code/west_march/hex_editor/hex_type_properties.py b/utilities/archived_code/west_march/hex_editor/hex_type_properties.py
new file mode 100644
index 000000000..c9bc1ac68
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_editor/hex_type_properties.py
@@ -0,0 +1,103 @@
+from PyQt5.QtWidgets import QWidget, QSpacerItem, \
+    QLineEdit, QHBoxLayout, QVBoxLayout, \
+    QMessageBox, QSizePolicy, QDoubleSpinBox
+from PyQt5.QtGui import QColor
+from PyQt5.QtCore import Qt
+
+from app.data.database import DB
+
+from app.extensions.custom_gui import PropertyBox
+from app.extensions.color_icon import ColorIcon
+from app.extensions.list_widgets import AppendMultiListWidget
+from app.extensions.list_models import DoubleListModel
+from app.editor.hex_editor.hex_event_delegate import HexEventDelegate
+from app.utilities import str_utils
+
+class HexTypeProperties(QWidget):
+    def __init__(self, parent, current=None):
+        super().__init__(parent)
+        self.window = parent
+        self._data = self.window._data
+
+        self.current = current
+
+        top_section = QHBoxLayout()
+
+        self.icon_edit = ColorIcon(QColor(0, 0, 0), self)
+        self.icon_edit.colorChanged.connect(self.on_color_change)
+        top_section.addWidget(self.icon_edit)
+
+        horiz_spacer = QSpacerItem(40, 10, QSizePolicy.Fixed, QSizePolicy.Fixed)
+        top_section.addSpacerItem(horiz_spacer)
+
+        name_section = QVBoxLayout()
+
+        self.nid_box = PropertyBox("Unique ID", QLineEdit, self)
+        self.nid_box.edit.textChanged.connect(self.nid_changed)
+        self.nid_box.edit.editingFinished.connect(self.nid_done_editing)
+        name_section.addWidget(self.nid_box)
+
+        self.name_box = PropertyBox("Display Name", QLineEdit, self)
+
+        self.name_box.edit.textChanged.connect(self.name_changed)
+        name_section.addWidget(self.name_box)
+
+        top_section.addLayout(name_section)
+
+        main_section = QVBoxLayout()
+
+        movement_section = QHBoxLayout()
+        self.movement_box = PropertyBox("Movement Cost", QDoubleSpinBox, self)
+        self.movement_box.edit.setRange(0, 100)
+        self.movement_box.edit.setSingleStep(0.25)
+        self.movement_box.edit.setAlignment(Qt.AlignRight)
+        self.movement_box.edit.valueChanged.connect(self.movement_changed)
+        movement_section.addWidget(self.movement_box)
+
+        main_section.addLayout(movement_section)
+
+        attrs = ("event_nid", "event_chance")
+        self.hex_event_widget = AppendMultiListWidget([], "Hex Events", attrs, HexEventDelegate, self, model=DoubleListModel)
+        main_section.addWidget(self.hex_event_widget)
+
+        total_section = QVBoxLayout()
+        self.setLayout(total_section)
+        total_section.addLayout(top_section)
+        total_section.addLayout(main_section)
+        total_section.setAlignment(Qt.AlignTop)
+
+    def nid_changed(self, text):
+        self.current.nid = text
+        self.window.update_list()
+
+    def nid_done_editing(self):
+        # Check validity of nid!
+        other_nids = [hex_type.nid for hex_type in DB.hex_types.values() if hex_type is not self.current]
+        if self.current.nid in other_nids:
+            QMessageBox.warning(self.window, 'Warning', 'Hex Type ID %s already in use' % self.current.nid)
+            self.current.nid = str_utils.get_next_int(self.current.nid, other_nids)
+        DB.hex_types.update_nid(self.current, self.current.nid)
+        self.window.update_list()
+
+    def name_changed(self, text):
+        self.current.name = text
+        self.window.update_list()
+
+    def movement_changed(self, index):
+        self.current.movement_cost = self.movement_box.edit.value()
+
+    def on_color_change(self, color):
+        self.current.color = tuple(color.getRgb()[:3])
+        self.window.update_list()
+
+    def set_current(self, current):
+        self.current = current
+        self.nid_box.edit.setText(current.nid)
+        self.name_box.edit.setText(current.name)
+        self.movement_box.edit.setValue(current.movement_cost)
+
+        self.hex_event_widget.set_current(current.events)
+
+        # Icon
+        color = current.color
+        self.icon_edit.change_color(QColor(color[0], color[1], color[2]))
diff --git a/utilities/archived_code/west_march/hex_editor/hex_type_tab.py b/utilities/archived_code/west_march/hex_editor/hex_type_tab.py
new file mode 100644
index 000000000..f608a1fc3
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_editor/hex_type_tab.py
@@ -0,0 +1,35 @@
+from app.data.database import DB
+
+from app.editor.data_editor import SingleDatabaseEditor
+from app.editor.base_database_gui import DatabaseTab
+from app.editor.hex_editor import hex_type_properties, hex_type_model
+
+class HexTypeDatabase(DatabaseTab):
+    @classmethod
+    def create(cls, parent=None):
+        data = DB.hex_types
+        title = "Hex Type"
+        right_frame = hex_type_properties.HexTypeProperties
+
+        def deletion_func(model, index):
+            return len(model._data) > 1
+
+        collection_model = hex_type_model.HexTypeModel
+        dialog = cls(data, title, right_frame, (deletion_func, None, None), collection_model, parent)
+        return dialog
+
+def get_editor():
+    return SingleDatabaseEditor(HexTypeDatabase)
+
+# Testing
+# Run "python -m app.editor.hex_type_editor.hex_type_tab" from main directory
+if __name__ == '__main__':
+    import sys
+    from PyQt5.QtWidgets import QApplication
+    app = QApplication(sys.argv)
+    from app.resources.resources import RESOURCES
+    RESOURCES.load('default.ltproj')
+    DB.load('default.ltproj')
+    window = SingleDatabaseEditor(HexTypeDatabase)
+    window.show()
+    app.exec_()
diff --git a/utilities/archived_code/west_march/hex_math.py b/utilities/archived_code/west_march/hex_math.py
new file mode 100644
index 000000000..31b58dbba
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_math.py
@@ -0,0 +1,140 @@
+import math
+
+from dataclasses import dataclass
+from typing import Tuple
+
+Hex = Tuple[float, float, float]
+hex_directions = [(1, 0, -1), (1, -1, 0), (0, -1, 1), (-1, 0, 1), (-1, 1, 0), (0, 1, -1)]
+
+def hex_add(a: Hex, b: Hex) -> Hex:
+    return a[0] + b[0], a[1] + b[1], a[2] + b[2]
+
+def hex_sub(a: Hex, b: Hex) -> Hex:
+    return a[0] - b[0], a[1] - b[1], a[2] - b[2]
+
+def hex_scale(h: Hex, k: float) -> Hex:
+    return h[0] * k, h[1] * k, h[2] * k
+
+def hex_length(h: Hex) -> float:
+    return (abs(h[0]) + abs(h[1]) + abs(h[2])) / 2
+
+def get_neighbors(h: Hex) -> list:
+    return [hex_add(h, direction) for direction in hex_directions]
+
+@dataclass
+class Orientation:
+    f0: float = 0
+    f1: float = 0
+    f2: float = 0
+    f3: float = 0
+    b0: float = 0
+    b1: float = 0
+    b2: float = 0
+    b3: float = 0
+    start_angle: float = 0
+
+orientation_horizontal = Orientation(math.sqrt(3), math.sqrt(3) / 2, 0, 3 / 2, math.sqrt(3) / 3, -1 / 3, 0, 2 / 3, 0.5)
+orientation_vertical = Orientation(3 / 2, 0, math.sqrt(3) / 2, math.sqrt(3), 2 / 3, 0, -1 / 3, math.sqrt(3) / 3, 0.0)
+
+@dataclass
+class Layout:
+    orientation: Orientation = None
+    size: tuple = None
+    origin: tuple = None
+
+def default_layout(size: float = 16):
+    return Layout(orientation_horizontal, (size, size), (0, 0))
+
+def calculate_distance(a: Hex, b: Hex) -> float:
+    c = hex_sub(a, b)
+    return hex_length(c)
+
+def hex_round(h: Hex) -> Hex:
+    qi = int(round(h[0]))
+    ri = int(round(h[1]))
+    si = int(round(h[2]))
+    q_diff = abs(qi - h[0])
+    r_diff = abs(ri - h[1])
+    s_diff = abs(si - h[2])
+    if q_diff > r_diff and q_diff > s_diff:
+        qi = -ri - si
+    elif r_diff > s_diff:
+        ri = -qi - si
+    else:
+        si = -qi - ri
+    return (qi, ri, si)
+
+def hex_lerp(a: Hex, b: Hex, t: float) -> Hex:
+    return (a[0] * (1 - t) + b[0] * t, a[1] * (1 - t) + b[1] * t, a[2] * (1 - t) + b[2] * t)
+
+def hex_linedraw(a: Hex, b: Hex) -> list:
+    """
+    Returns a list of the Hex points that can be used to draw a line between the two Hexes
+    Use these Hex points to figure out what hexes you cross
+    """
+    n = calculate_distance(a, b)
+    a_nudge = (a[0] + 1e-6, a[1] + 1e-6, a[2] - 2e-6)
+    b_nudge = (b[0] + 1e-6, b[1] + 1e-6, b[2] - 2e-6)
+    results = []
+    step = 1.0 / max(n, 1)
+    for i in range(n + 1):
+        results.append(hex_round(hex_lerp(a_nudge, b_nudge, step * i)))
+    return results
+
+EVEN = 1
+ODD = -1
+def roffset_from_cube(offset, h: Hex) -> tuple:
+    col = h[0] + (h[1] + offset * (h[1] & 1)) // 2
+    row = h[1]
+    if offset != EVEN and offset != ODD:
+        raise ValueError("offset %s must be EVEN (+1) or ODD (-1)" % offset)
+    return (col, row)
+
+def roffset_to_cube(offset, h: tuple) -> Hex:
+    q = h[0] - (h[1] + offset * (h[1] & 1)) // 2
+    r = h[1]
+    s = -q - r
+    if offset != EVEN and offset != ODD:
+        raise ValueError("offset %s must be EVEN (+1) or ODD (-1)" % offset)
+    return (q, r, s)
+
+def _hex_to_pixel(layout: Layout, h: Hex) -> tuple:
+    m = layout.orientation
+    x = (m.f0 * h[0] + m.f1 * h[1]) * layout.size[0]
+    y = (m.f2 * h[0] + m.f3 * h[1]) * layout.size[1]
+    return (x + layout.origin[0], y + layout.origin[1])
+
+def hex_to_pixel(h: Hex) -> tuple:
+    return _hex_to_pixel(default_layout(), h)
+
+def _pixel_to_hex(layout: Layout, p: tuple) -> Hex:
+    m = layout.orientation
+    pt = (p[0] - layout.origin[0]) / layout.size[0], (p[1] - layout.origin[1]) / layout.size[1]
+    q = m.b0 * pt[0] + m.b1 * pt[1]
+    r = m.b2 * pt[0] + m.b3 * pt[1]
+    return (q, r, -q - r)
+
+def pixel_to_hex(h: Hex) -> tuple:
+    return _pixel_to_hex(default_layout(), h)
+
+def hex_corner_offset(layout: Layout, corner: int) -> tuple:
+    m = layout.orientation
+    size = layout.size
+    angle = 2 * math.pi * (m.start_angle - corner) / 6.0
+    return size[0] * math.cos(angle), size[1] * math.sin(angle)
+
+def polygon_corners(layout: Layout, h: Hex) -> list:
+    corners = []
+    center = _hex_to_pixel(layout, h)
+    for i in range(6):
+        offset = hex_corner_offset(layout, i)
+        corners.append((center[0] + offset[0], center[1] + offset[1]))
+    return corners
+
+def get_all_hex_within_distance(h: Hex, dist: int) -> list:
+    neighbors = []
+    for q in range(-dist, dist + 1):
+        for r in range(max(-dist, -q - dist), min(dist, -q + dist) + 1):
+            s = -q - r
+            neighbors.append(hex_add(h, (q, r, s)))
+    return neighbors
diff --git a/utilities/archived_code/west_march/hex_prefab.py b/utilities/archived_code/west_march/hex_prefab.py
new file mode 100644
index 000000000..bc699a96f
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_prefab.py
@@ -0,0 +1,40 @@
+from typing import Tuple, Dict
+
+from app.utilities.data import Prefab
+from app.utilities import hex_math
+
+class HexPrefab(Prefab):
+    def __init__(self, pos: hex_math.Hex, name: str = '', hex_type: str = None):
+        self.pos: hex_math.Hex = pos
+        self.name: str = name
+        self.hex_type: str = hex_type
+
+    def get_position_label(self) -> str:
+        return "(q: %s, r: %s, s: %s)" % (self.pos[0], self.pos[1], self.pos[2])
+
+    def restore_attr(self, name, value):
+        if name == 'pos':
+            value = tuple(value)
+        else:
+            value = super().restore_attr(name, value)
+        return value
+
+    @classmethod
+    def default(cls):
+        return cls((0, 0, 0), '', None)
+
+class OverworldHexCatalog(Dict[Tuple, HexPrefab]):
+    def get_by_name(self, name):
+        for hex_prefab in self.values():
+            if hex_prefab.name == name:
+                return hex_prefab
+        return None
+        
+    def save(self):
+        return [elem.save() for elem in self.values()]
+
+    def restore(self, vals):
+        self.clear()
+        for s_dict in vals:
+            new_hex = HexPrefab.restore(s_dict)
+            self[new_hex.pos] = new_hex
diff --git a/utilities/archived_code/west_march/hex_properties.py b/utilities/archived_code/west_march/hex_properties.py
new file mode 100644
index 000000000..9cc70af5f
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_properties.py
@@ -0,0 +1,82 @@
+from PyQt5.QtWidgets import QVBoxLayout, \
+    QWidget, QLabel, QLineEdit
+from PyQt5.QtCore import Qt
+
+from app.extensions.custom_gui import PropertyBox, ComboBox
+
+from app.data.database import DB
+from app.editor.custom_widgets import HexTypeBox
+
+class HexPropertiesMenu(QWidget):
+    def __init__(self, state_manager):
+        super().__init__()
+        self.state_manager = state_manager
+
+        self._initialize_components()
+
+        # widget state
+        self.current_hex = None
+        self.select_hex(self.state_manager.state.selected_node)
+
+        # subscriptions
+        self.state_manager.subscribe_to_key(HexPropertiesMenu.__name__, 'selected_node', self.select_hex)
+
+    def select_hex(self, hex_prefab):
+        current_overworld = DB.overworlds.get(self.state_manager.state.selected_overworld)
+        if current_overworld:
+            self.current_hex = hex_prefab
+        else:
+            self.current_hex = None
+        if self.current_hex:
+            # Reset Hex Types
+            self.hex_type_box.edit.clear()
+            for hex_type in DB.hex_types:
+                self.hex_type_box.edit.addItem(hex_type.nid)            
+
+            self.position_label.setText(self.current_hex.get_position_label())
+            if self.current_hex.hex_type:
+                self.hex_type_box.edit.setValue(self.current_hex.hex_type)
+            elif DB.hex_types:
+                self.hex_type_box.edit.setValue(DB.hex_types.keys()[0])
+            if self.current_hex.name:
+                self.name_box.edit.setText(self.current_hex.name)
+            else:
+                self.name_box.edit.setText('')
+            self.set_components_active(True)
+        else:
+            self.position_label.setText("No Hex Selected")
+            self.set_components_active(False)
+
+    def set_components_active(self, is_active):
+        is_inactive = not is_active
+        self.hex_type_box.setDisabled(is_inactive)
+        self.name_box.setDisabled(is_inactive)
+
+    def hex_type_changed(self):
+        if self.current_hex:
+            print("Hex Type Changed!", self.current_hex, self.hex_type_box.edit.currentText())
+            self.current_hex.hex_type = self.hex_type_box.edit.currentText()
+
+    def name_changed(self, text):
+        if self.current_hex:
+            self.current_hex.name = text
+            self.state_manager.change_and_broadcast('ui_refresh_signal', None)
+
+    def _initialize_components(self):
+        self.setStyleSheet("font: 10pt;")
+        self.layout = QVBoxLayout(self)
+        self.layout.setAlignment(Qt.AlignTop)
+
+        self.position_label = QLabel()
+        self.position_label.setText("No Hex Selected")
+        self.layout.addWidget(self.position_label)
+
+        self.name_box = PropertyBox("Unique Name", QLineEdit, self)
+        self.name_box.edit.textChanged.connect(self.name_changed)
+        self.layout.addWidget(self.name_box)
+
+        self.hex_type_box = PropertyBox("Hex Type", ComboBox, self)
+        for hex_type in DB.hex_types:
+            self.hex_type_box.edit.addItem(hex_type.nid)
+        self.hex_type_box.edit.activated.connect(self.hex_type_changed)
+        self.layout.addWidget(self.hex_type_box)
diff --git a/utilities/archived_code/west_march/hex_type.py b/utilities/archived_code/west_march/hex_type.py
new file mode 100644
index 000000000..69a797575
--- /dev/null
+++ b/utilities/archived_code/west_march/hex_type.py
@@ -0,0 +1,37 @@
+from dataclasses import dataclass
+
+from app.utilities.data import Data, Prefab
+
+@dataclass
+class HexEvent(Prefab):
+    event_nid: str = None
+    event_chance: float = 1.
+
+@dataclass
+class HexType(Prefab):
+    nid: str = None
+    name: str = None
+
+    color: tuple = (0, 0, 0)
+
+    movement_cost: str = None
+
+    events: list = None  # Events and their chance to occur in this Hex Type
+
+    def save_attr(self, name, value):
+        if name == 'events':
+            return [(event.event_nid, event.event_chance) for event in self.events]
+        else:
+            return super().save_attr(name, value)
+
+    def restore_attr(self, name, value):
+        if name == 'color':
+            value = tuple(value)
+        elif name == 'events':
+            value = [HexEvent(*dat) for dat in value]
+        else:
+            value = super().restore_attr(name, value)
+        return value
+
+class HexTypeCatalog(Data[HexType]):
+    datatype = HexType
diff --git a/utilities/archived_code/west_march/stat_screen.py b/utilities/archived_code/west_march/stat_screen.py
new file mode 100644
index 000000000..da9716dd8
--- /dev/null
+++ b/utilities/archived_code/west_march/stat_screen.py
@@ -0,0 +1,324 @@
+from app.constants import STATWIDTH, WINHEIGHT
+
+from app.data.database import DB
+from app.utilities import utils
+
+from app.engine.fonts import FONT
+from app.engine.sound import get_sound_thread
+from app.engine.sprites import SPRITES
+from app.engine.input_manager import INPUT
+from app.engine.state import MapState
+from app.engine import engine, info_menu, text_funcs, \
+    icons, image_mods, item_funcs, menu_options, help_menu
+from app.engine.game_state import game
+from app.engine.fluid_scroll import FluidScroll
+
+def handle_info():
+    if game.cursor.get_hover():
+        get_sound_thread().play_sfx('Select 1')
+        game.state.change('stat_screen')
+    else:
+        get_sound_thread().play_sfx('Select 3')
+        game.boundary.toggle_all_enemy_attacks()
+
+def build_groove(surf, topleft, width, fill):
+    bg = SPRITES.get('groove_back')
+    start = engine.subsurface(bg, (0, 0, 2, 5))
+    mid = engine.subsurface(bg, (2, 0, 1, 5))
+    end = engine.subsurface(bg, (3, 0, 2, 5))
+    fg = SPRITES.get('groove_fill')
+
+    # Build back groove
+    surf.blit(start, topleft)
+    for idx in range(width - 2):
+        mid_pos = (topleft[0] + 2 + idx, topleft[1])
+        surf.blit(mid, mid_pos)
+    surf.blit(end, (topleft[0] + width, topleft[1]))
+
+    # Build fill groove
+    number_needed = int(fill * (width - 1))  # Width of groove minus section for start and end
+    for groove in range(number_needed):
+        surf.blit(fg, (topleft[0] + 1 + groove, topleft[1] + 1))
+
+class StatScreenState(MapState):
+    name = 'stat_screen'
+
+    def start(self):
+        self.fluid = FluidScroll(200, 1)
+
+        get_sound_thread().play_sfx('Info In')
+        game.stat_screen.toggle_info(True)
+        game.stat_screen.info_graph.set_transition_in()
+
+    def take_input(self, event):
+        first_push = self.fluid.update()
+        directions = self.fluid.get_directions()
+
+        self.handle_mouse()
+        if game.stat_screen.info_flag:
+            if event == 'INFO' or event == 'BACK':
+                get_sound_thread().play_sfx('Info Out')
+                game.stat_screen.info_graph.set_transition_out()
+                game.state.back()
+
+            if 'RIGHT' in directions:
+                get_sound_thread().play_sfx('Select 6')
+                game.stat_screen.info_graph.move_right()
+            elif 'LEFT' in directions:
+                get_sound_thread().play_sfx('Select 6')
+                game.stat_screen.info_graph.move_left()
+            elif 'UP' in directions:
+                get_sound_thread().play_sfx('Select 6')
+                game.stat_screen.info_graph.move_up()
+            elif 'DOWN' in directions:
+                get_sound_thread().play_sfx('Select 6')
+                game.stat_screen.info_graph.move_down()
+
+    def handle_mouse(self):
+        mouse_position = INPUT.get_mouse_position()
+        if not mouse_position:
+            return
+        if game.stat_screen.info_flag:
+            game.stat_screen.info_graph.handle_mouse(mouse_position)
+
+    def finish(self):
+        game.stat_screen.toggle_info(False)
+
+class StatScreen():
+    def __init__(self):
+        self.bg = SPRITES.get('stat_screen_background')
+        self.unit = None
+        self._next_unit = None
+
+        self.info_graph = info_menu.InfoGraph()
+        self.info_flag = False
+        self.info_graph.set_current_state('personal_data')
+        self.reset_surfs()
+
+        self.transition = None
+        self.transition_counter = 0
+
+        self._saved_items = []
+
+    def reset_surfs(self):
+        self.info_graph.clear()
+        self.portrait_surf = None
+        self.personal_data_surf = None
+
+    def toggle_info(self, val=False):
+        self.info_flag = val
+
+    def update(self):
+        hover = game.cursor.get_hover()
+        if hover and game.state.current() == 'free':
+            if hover != self.unit:
+                self._next_unit = hover
+                self.transition = 'out'
+
+        if self.transition == 'out':
+            self.transition_counter += 1
+            self.transparency = self.transition_counter / 5
+            if self.transparency >= 1:
+                self.transition = 'in'
+                self.transparency = 1
+                self.unit = self._next_unit
+                self._next_unit = None
+                self.reset_surfs()
+
+        elif self.transition == 'in':
+            self.transition_counter -= 1
+            self.transparency = self.transition_counter / 5
+            if self.transparency <= 0:
+                self.transition = None
+                self.transparency = 0
+
+    def draw(self, surf):
+        self.update()
+        # Make sure item ordering hasn't changed
+        if self.unit and self.unit.items != self._saved_items:
+            self.reset_surfs()
+
+        if self.bg:
+            surf.blit(self.bg, (0, 0))
+        if self.unit:
+            self.draw_portrait(surf)
+            self.draw_slide(surf)
+        if self.info_graph.current_bb:
+            self.info_graph.draw(surf)
+        return surf
+
+    def draw_portrait(self, surf):
+        if not self.portrait_surf:
+            self.portrait_surf = self.create_portrait()
+
+        # Stick it on the surface
+        if self.transparency:
+            im = image_mods.make_translucent(self.portrait_surf, self.transparency)
+            surf.blit(im, (0, 0))
+        else:
+            surf.blit(self.portrait_surf, (0, 0))
+
+    def create_portrait(self):
+        surf = engine.create_surface((STATWIDTH, WINHEIGHT), transparent=True)
+        surf.blit(SPRITES.get('info_unit'), (54, 82))
+
+        im, offset = icons.get_portrait(self.unit)
+        if im:
+            width = im.get_width()
+            if width < 112:
+                x_pos = (width - 80)//2
+                portrait_surf = engine.subsurface(im, (x_pos, offset, 80, 72))
+                portrait_surf = engine.flip_horiz(portrait_surf)
+                surf.blit(portrait_surf, (16, 2))
+            else:
+                x_pos = (width - 112)//2
+                portrait_surf = engine.subsurface(im, (x_pos, offset, 112, 72))
+                portrait_surf = engine.flip_horiz(portrait_surf)
+                surf.blit(portrait_surf, (0, 2))
+
+        class_obj = DB.classes.get(self.unit.klass)
+        if self.unit.generic:
+            FONT['text'].blit(class_obj.name, surf, (8, 80))
+            self.info_graph.register((8, 80, 72, 16), class_obj.desc, 'all', first=True)
+        else:
+            FONT['text'].blit(self.unit.name, surf, (8, 80))
+            self.info_graph.register((8, 80, 72, 16), self.unit.desc, 'all', first=True)
+        FONT['text-blue'].blit_right(str(self.unit.level), surf, (86, 80))
+        self.info_graph.register((50, 80, 30, 16), 'Level_desc', 'all')
+        FONT['text-blue'].blit_right(str(self.unit.exp), surf, (110, 80))
+        self.info_graph.register((86, 80, 30, 16), 'Exp_desc', 'all')
+        # FONT['text-blue'].blit_right(str(self.unit.get_hp()), surf, (86, 96))
+        self.info_graph.register((50, 96, 72, 16), 'HP_desc', 'all')
+        max_hp = self.unit.get_max_hp()
+        FONT['text-blue'].blit_right(str(max_hp), surf, (110, 96))
+        affinity = DB.affinities.get(self.unit.affinity)
+        # Affinity needs icons!
+        if affinity:
+            icons.draw_item(surf, affinity, (4, 16))
+            self.info_graph.register((4, 24, 16, 16), affinity.desc, 'all')
+
+        # Skills
+        skills = [skill for skill in self.unit.skills if skill.class_skill and not skill.hidden]
+        for idx, skill in enumerate(skills):
+            left_pos = idx * 24
+            icons.draw_skill(surf, skill, (left_pos + 8, 96), compact=True)
+            help_box = help_menu.HelpDialog(skill.desc, name=skill.name)
+            self.info_graph.register((left_pos + 8, 96, 16, 16), help_box, 'all')
+
+        return surf
+
+    def draw_slide(self, surf):
+        if not self.personal_data_surf:
+            self.personal_data_surf = self.create_slide()
+        
+        buffer_surf = self.personal_data_surf.copy()
+        FONT['text-blue'].blit_right(str(self.unit.get_hp()), buffer_surf, (86, 96))
+
+        # Stick it on the surface
+        if self.transparency:
+            im = image_mods.make_translucent(buffer_surf, self.transparency)
+            surf.blit(im, (0, 0))
+        else:
+            surf.blit(buffer_surf, (0, 0))
+
+    def create_slide(self):
+        menu_size = STATWIDTH, WINHEIGHT
+        surf = engine.create_surface(menu_size, transparent=True)
+
+        self.draw_stats(surf, 116)
+        self.draw_equipment(surf, 152)
+
+        return surf
+
+    def draw_stats(self, surf, top):
+        class_obj = DB.classes.get(self.unit.klass)
+        max_stats = class_obj.max_stats
+
+        stats = [stat.nid for stat in DB.stats if stat.position == 'left']
+        # Make sure we only display up to 6 on each
+
+        for idx, stat_nid in enumerate(stats):
+            left = 37 * (idx // 2)
+            y_pos = top + 16 * (idx % 2)
+            icons.draw_stat(surf, stat_nid, self.unit, (36 + left, y_pos), compact=True)
+            # Name
+            name = DB.stats.get(stat_nid).name
+            FONT['text-yellow'].blit(name, surf, (1 + left, y_pos))
+            base_value = self.unit.stats.get(stat_nid, 0)
+            contribution = self.unit.stat_contribution(stat_nid)
+            contribution['Base Value'] = base_value
+            help_box = help_menu.StatDialog('%s_desc' % stat_nid, contribution)
+            self.info_graph.register((1 + left, y_pos, 40, 16), help_box, 'all')
+
+        # Mana / MEM
+        if self.unit.generic:
+            mana = '--'
+        else:
+            mana = str(self.unit.get_mana())
+        left, y_pos = (37*2, top + 16 * 1)
+        FONT['text-blue'].blit_right(mana, surf, (36 + left, y_pos))
+        FONT['text-yellow'].blit(text_funcs.translate('MANA'), surf, (1 + left, y_pos))
+        self.info_graph.register((1 + left, y_pos, 40, 16), 'MANA_desc', 'all')
+
+        return surf
+
+    def draw_equipment(self, surf, top):
+        # Equipment
+        weapon = self.unit.get_weapon()
+        accessory = self.unit.get_accessory()
+        self._saved_items = self.unit.items
+
+        # Blit items
+        for idx, item in enumerate(self.unit.nonaccessories):
+            y_pos = idx * 16 + top
+            if item.multi_item and any(subitem is weapon for subitem in item.subitems):
+                surf.blit(SPRITES.get('equipment_highlight'), (2, y_pos + 8))
+                for subitem in item.subitems:
+                    if subitem is weapon:
+                        item_option = menu_options.ItemOption(idx, subitem)
+                        break
+                else:  # Shouldn't happen
+                    item_option = menu_options.ItemOption(idx, item)
+            else:
+                if item is weapon:
+                    surf.blit(SPRITES.get('equipment_highlight'), (2, y_pos + 8))
+                item_option = menu_options.ItemOption(idx, item)
+            item_option.draw(surf, 2, y_pos)
+            self.info_graph.register((2, y_pos, 108, 16), item_option.get_help_box(), 'all')
+
+        # Blit accessories
+        for idx, item in enumerate(self.unit.accessories):
+            aidx = item_funcs.get_num_items(self.unit) + idx
+            y_pos = aidx * 16 + top
+            if item.multi_item and any(subitem is accessory for subitem in item.subitems):
+                surf.blit(SPRITES.get('equipment_highlight'), (2, y_pos + 8))
+                for subitem in item.subitems:
+                    if subitem is accessory:
+                        if not item_funcs.available(self.unit, subitem) and subitem.memento_skill_on_hold:
+                            skill = [s for s in self.unit.skills if s.nid == subitem.memento_skill_on_hold.value][0]
+                            item_option = menu_options.MementoSkillOption(aidx, skill)
+                        else:
+                            item_option = menu_options.MementoAccessoryItemOption(aidx, subitem)
+                        break
+                else:  # Shouldn't happen
+                    if not item_funcs.available(self.unit, subitem) and subitem.memento_skill_on_hold:
+                        skill = [s for s in self.unit.skills if s.nid == subitem.memento_skill_on_hold.value][0]
+                        item_option = menu_options.MementoSkillOption(aidx, skill)
+                    else:
+                        item_option = menu_options.MementoAccessoryItemOption(aidx, subitem)
+            else:
+                if item is accessory:
+                    surf.blit(SPRITES.get('equipment_highlight'), (2, y_pos + 8))
+                if not item_funcs.available(self.unit, item) and item.memento_skill_on_hold:
+                    skills = [s for s in self.unit.skills if s.nid == item.memento_skill_on_hold.value]
+                    if skills:
+                        item_option = menu_options.MementoSkillOption(aidx, skills[0])
+                    else:
+                        item_option = menu_options.MementoAccessoryItemOption(aidx, item)
+                else:
+                    item_option = menu_options.MementoAccessoryItemOption(aidx, item)
+            item_option.draw(surf, 2, y_pos)
+            first = (idx == 0 and not self.unit.nonaccessories)
+            self.info_graph.register((2, y_pos, 108, 16), item_option.get_help_box(), 'all', first=first)
+
+        return surf
diff --git a/utilities/archived_code/west_march/testing_harness.py b/utilities/archived_code/west_march/testing_harness.py
new file mode 100644
index 000000000..f01caeb7f
--- /dev/null
+++ b/utilities/archived_code/west_march/testing_harness.py
@@ -0,0 +1,32 @@
+import pygame
+import cProfile
+
+from app.constants import WINWIDTH, WINHEIGHT
+from app.shaders import shaders
+
+WINWIDTH, WINHEIGHT = 1920//2, 1080//2
+num_frames = 100
+
+def main():
+    pr = cProfile.Profile()
+    pygame.init()
+    screen_size = (WINWIDTH*2, WINHEIGHT*2)
+    screen = pygame.display.set_mode(screen_size)
+    surf = pygame.Surface((WINWIDTH, WINHEIGHT))
+    img = pygame.image.load('../west_march/west_march.ltproj/resources/panoramas/title_background.png')
+    print(img)
+    pr.enable()
+    for _ in range(num_frames):
+        tmp_surf = surf.convert()
+        tmp_surf.blit(img, (0, 0))
+        shaders.bloom(tmp_surf, 176, True)
+        # shaders.invert(tmp_surf)
+        pygame.transform.scale(tmp_surf, screen_size, screen)
+        pygame.display.update()
+    pr.disable()
+    pr.print_stats(sort='cumtime')
+    pygame.quit()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/utilities/archived_code/west_march/tilemap_object_from_scratch.py b/utilities/archived_code/west_march/tilemap_object_from_scratch.py
