@@ -0,0 +1,6 @@
+from .simple_renderer import SimpleRenderer
+from .limit_renderer import SimpleLimitRenderer, LimitRenderer, \
+    SimpleLimitShadingRenderer
+from .shading_renderer import SimpleShadingRenderer, FloorShadingRenderer, \
+    CheckerboardFloorShadingRenderer, Limit8ShadingRenderer, \
+    Limit16ShadingRenderer
diff --git a/app/dungeon_maker/pygame_renderers/limit_renderer.py b/app/dungeon_maker/pygame_renderers/limit_renderer.py
new file mode 100644
index 000000000..c95d119b4
--- /dev/null
+++ b/app/dungeon_maker/pygame_renderers/limit_renderer.py
@@ -0,0 +1,38 @@
+from typing import Dict
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.pygame_renderers.renderer_utils import find_limit16, get_image16
+from app.engine import engine
+
+class SimpleLimitRenderer:
+    def __init__(self, painter: Painter, image_fn: str):
+        self.painter = painter
+        self.image = engine.image_load(image_fn)
+        limits: Dict[int, int] = {0: find_limit16(self.image, 0)}
+        self.painter.set_limit(limits)
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        coord = self.painter.get_coord(dungeon_tilemap, position)
+        return get_image16(self.image, coord)
+
+class LimitRenderer(SimpleLimitRenderer):
+    def __init__(self, painter: Painter, image_fn: str):
+        self.painter = painter
+        self.image = engine.image_load(image_fn)
+        limits: Dict[int, int] = {k: find_limit16(self.image, k) for k in range(16)}
+        self.painter.set_limit(limits)
+
+class SimpleLimitShadingRenderer(SimpleLimitRenderer):
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        coord, shading_coord = self.painter.get_coord(dungeon_tilemap, position)
+        im = get_image16(self.image, coord)
+
+        if shading_coord:
+            shading_im = get_image16(self.image, shading_coord)
+            im.blit(shading_im, (0, 0))
+
+        return im
diff --git a/app/dungeon_maker/pygame_renderers/renderer_utils.py b/app/dungeon_maker/pygame_renderers/renderer_utils.py
new file mode 100644
index 000000000..cf66b5b23
--- /dev/null
+++ b/app/dungeon_maker/pygame_renderers/renderer_utils.py
@@ -0,0 +1,36 @@
+from typing import Tuple
+
+from app.constants import TILEWIDTH, TILEHEIGHT
+from app.utilities.typing import Pos
+
+from app.engine import engine
+
+def _get_image(base_image: engine.Surface, coord: Pos, tile_size: Tuple[int, int]) -> engine.Surface:
+    width, height = tile_size
+    im = engine.subsurface(base_image, (
+        coord[0] * width,
+        coord[1] * height,
+        width, height))
+    return im.copy()
+
+def get_image8(base_image: engine.Surface, coord: Pos) -> engine.Surface:
+    return _get_image(base_image, coord, (TILEWIDTH // 2, TILEHEIGHT // 2))
+
+def get_image16(base_image: engine.Surface, coord: Pos) -> engine.Surface:
+    return _get_image(base_image, coord, (TILEWIDTH, TILEHEIGHT))
+
+def _find_limit(image: engine.Surface, idx: int, skip: Tuple[int, int]) -> int:
+    bg_color = (0, 0, 0)
+    x = idx * skip[0]
+    for y in range(0, image.get_height(), skip[1]):
+        current_color = image.get_at((x, y))
+        # If we've reached the bottom of the column in our image
+        if current_color[:3] == bg_color[:3]:
+            return y // skip[1]
+    return image.get_height() // skip[1]
+
+def find_limit8(image: engine.Surface, idx: int) -> int:
+    return _find_limit(image, idx, (TILEWIDTH // 2, TILEHEIGHT // 2))
+
+def find_limit16(image: engine.Surface, idx: int) -> int:
+    return _find_limit(image, idx, (TILEWIDTH, TILEHEIGHT))
diff --git a/app/dungeon_maker/pygame_renderers/renderers.py b/app/dungeon_maker/pygame_renderers/renderers.py
new file mode 100644
index 000000000..707e42a52
--- /dev/null
+++ b/app/dungeon_maker/pygame_renderers/renderers.py
@@ -0,0 +1,90 @@
+from typing import Any, Dict
+from functools import lru_cache
+
+import os
+
+from app.dungeon_maker.terrain import Terrain
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.painters import (
+    FloorPainter, 
+    WallTopPainter, 
+    WallBottomPainter,
+    StairsUpDownPainter, 
+    StairsLeftPainter, 
+    StairsRightPainter, 
+    RandomPainter,
+    RandomShadingPainter,
+    GrassPainter,
+    RuinsPainter,
+    WaterPainter,
+    WaterBridgePainter,
+)
+from app.dungeon_maker.pygame_renderers import (
+    SimpleRenderer,
+    SimpleLimitRenderer, 
+    SimpleLimitShadingRenderer, 
+    LimitRenderer, 
+    SimpleShadingRenderer,
+    FloorShadingRenderer,
+    CheckerboardFloorShadingRenderer,
+    Limit8ShadingRenderer,
+    Limit16ShadingRenderer,
+)
+
+class RendererDatabase:
+    """RendererDatabase = Dict[Terrain, Renderer]"""
+
+    def __init__(self, palette_dir: str):
+        self.palette_dir = palette_dir
+
+    @lru_cache(64)
+    def get(self, terrain: Terrain) -> Any:
+        match terrain:
+            case Terrain.VOID: 
+                return SimpleRenderer(Painter(), os.path.join(self.palette_dir, 'void.png'))
+            case Terrain.FLOOR_LOWER: 
+                return FloorShadingRenderer(FloorPainter(), os.path.join(self.palette_dir, 'floor1.png'), os.path.join(self.palette_dir, 'floor1_shading.png'))
+            case Terrain.FLOOR_UPPER: 
+                return FloorShadingRenderer(FloorPainter(), os.path.join(self.palette_dir, 'floor2.png'), os.path.join(self.palette_dir, 'floor2_shading.png'))
+            case Terrain.WALL_TOP: 
+                return LimitRenderer(WallTopPainter(), os.path.join(self.palette_dir, 'wall_top.png'))
+            case Terrain.WALL_BOTTOM: 
+                return SimpleRenderer(WallBottomPainter(), os.path.join(self.palette_dir, 'wall_bottom.png'))
+            case Terrain.STAIRS_UP: 
+                return SimpleRenderer(StairsUpDownPainter(), os.path.join(self.palette_dir, 'stairs_updown.png'))
+            case Terrain.STAIRS_DOWN: 
+                return SimpleRenderer(StairsUpDownPainter(), os.path.join(self.palette_dir, 'stairs_updown.png'))
+            case Terrain.STAIRS_LEFT: 
+                return SimpleRenderer(StairsLeftPainter(), os.path.join(self.palette_dir, 'stairs_left.png'))
+            case Terrain.STAIRS_RIGHT: 
+                return SimpleRenderer(StairsRightPainter(), os.path.join(self.palette_dir, 'stairs_right.png'))
+            case Terrain.PILLAR: 
+                return SimpleRenderer(Painter(), os.path.join(self.palette_dir, 'pillar.png'))
+            case Terrain.SPARSE_FOREST: 
+                return SimpleLimitShadingRenderer(RandomShadingPainter(), os.path.join(self.palette_dir, 'forest.png'))
+            case Terrain.GRASS: 
+                return Limit8ShadingRenderer(GrassPainter(), os.path.join(self.palette_dir, 'floor1.png'), os.path.join(self.palette_dir, 'floor1_shading.png'))
+            case Terrain.RUINS_LOWER: 
+                return Limit16ShadingRenderer(RuinsPainter(), os.path.join(self.palette_dir, 'floor1.png'), os.path.join(self.palette_dir, 'floor1_shading.png'))
+            case Terrain.RUINS_UPPER: 
+                return Limit16ShadingRenderer(RuinsPainter(), os.path.join(self.palette_dir, 'floor2.png'), os.path.join(self.palette_dir, 'floor2_shading.png'))
+            case Terrain.CHECKERBOARD_LOWER: 
+                return CheckerboardFloorShadingRenderer(FloorPainter(), os.path.join(self.palette_dir, 'floor1.png'), os.path.join(self.palette_dir, 'floor1_shading.png'), os.path.join(self.palette_dir, 'floor1_beta.png'), os.path.join(self.palette_dir, 'floor1_shading_beta.png'))
+            case Terrain.CHECKERBOARD_UPPER: 
+                return CheckerboardFloorShadingRenderer(FloorPainter(), os.path.join(self.palette_dir, 'floor2.png'), os.path.join(self.palette_dir, 'floor2_shading.png'), os.path.join(self.palette_dir, 'floor2_beta.png'), os.path.join(self.palette_dir, 'floor2_shading_beta.png'))
+            case Terrain.WATER: 
+                return FloorShadingRenderer(WaterPainter(), os.path.join(self.palette_dir, 'water.png'), os.path.join(self.palette_dir, 'water_shading.png'))
+            case Terrain.WATERBRIDGE: 
+                return SimpleShadingRenderer(WaterBridgePainter(), os.path.join(self.palette_dir, 'bridge.png'))
+            case Terrain.START: 
+                return SimpleRenderer(Painter(), os.path.join(self.palette_dir, 'start_end.png'))
+            case Terrain.END: 
+                return SimpleRenderer(Painter(), os.path.join(self.palette_dir, 'start_end.png'))
+
+def get_renderers(palette: str) -> RendererDatabase:
+    palette_dir = 'app/dungeon_maker/palettes/'
+    if os.path.isdir(palette_dir + palette):
+        palette_dir = palette_dir + palette
+    else:
+        palette_dir = palette_dir + "dungeon"
+    return RendererDatabase(palette_dir)
diff --git a/app/dungeon_maker/pygame_renderers/shading_renderer.py b/app/dungeon_maker/pygame_renderers/shading_renderer.py
new file mode 100644
index 000000000..22799d536
--- /dev/null
+++ b/app/dungeon_maker/pygame_renderers/shading_renderer.py
@@ -0,0 +1,175 @@
+import os
+from typing import Dict
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.pygame_renderers.renderer_utils import find_limit8, find_limit16, get_image8, get_image16
+from app.engine import engine
+
+class SimpleShadingRenderer:
+    def __init__(self, painter: Painter, image_fn: str):
+        self.painter = painter
+        self.image = engine.image_load(image_fn)
+        limit: int = find_limit16(self.image, 0)
+        self.painter.set_limit({0: limit})
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        coord = self.painter.get_coord(dungeon_tilemap, position)
+        shading_coord = self.painter.get_shading_coord(dungeon_tilemap, position)
+
+        base_image = get_image16(self.image, coord)
+
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = get_image16(self.image, shading_coord)
+
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+        return base_image
+
+class FloorShadingRenderer:
+    def __init__(self, painter: Painter, main_image_fn: str, shading_image_fn: str):
+        self.painter = painter
+        self.main_image = engine.image_load(main_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        limit: int = find_limit16(self.main_image, 0)
+        self.painter.set_limit({0: limit})
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap,
+                         position: Pos) -> engine.Surface:
+        coord = self.painter.get_coord(dungeon_tilemap, position)
+        shading_coord = self.painter.get_shading_coord(dungeon_tilemap, position)
+
+        base_image = get_image16(self.main_image, coord)
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        pillar_coord = self.painter.get_pillar_coord(dungeon_tilemap, position)
+        if pillar_coord:
+            extra_image = get_image16(self.shading_image, pillar_coord)
+        elif self.painter.is_column_bottom(dungeon_tilemap, position):
+            extra_image = get_image16(self.shading_image, (7, 0))
+
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+
+        return base_image
+
+class CheckerboardFloorShadingRenderer:
+    def __init__(self, painter: Painter, 
+                 main_alpha_image_fn: str, shading_alpha_image_fn: str,
+                 main_beta_image_fn: str, shading_beta_image_fn: str):
+        self.painter = painter
+        self.main_alpha_image = engine.image_load(main_alpha_image_fn)
+        self.shading_alpha_image = engine.image_load(shading_alpha_image_fn)
+        self.main_beta_image = engine.image_load(main_beta_image_fn)
+        self.shading_beta_image = engine.image_load(shading_beta_image_fn)
+        alpha_limit: int = find_limit16(self.main_alpha_image, 0)
+        beta_limit: int = find_limit16(self.main_beta_image, 0)
+        self.painter.set_limit({0: min(alpha_limit, beta_limit)})
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap,
+                         position: Pos) -> engine.Surface:
+        coord = self.painter.get_coord(dungeon_tilemap, position)
+        shading_coord = self.painter.get_shading_coord(dungeon_tilemap, position)
+
+        if (position[0] + position[1]) % 2 == 1:
+            main_image = self.main_beta_image
+            shadow_image = self.shading_beta_image
+        else:
+            main_image = self.main_alpha_image
+            shadow_image = self.shading_alpha_image
+
+        base_image = get_image16(main_image, coord)
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = get_image16(shadow_image, shading_coord)
+
+        extra_image = None
+        pillar_coord = self.painter.get_pillar_coord(dungeon_tilemap, position)
+        if pillar_coord:
+            extra_image = get_image16(shadow_image, pillar_coord)
+        elif self.painter.is_column_bottom(dungeon_tilemap, position):
+            extra_image = get_image16(shadow_image, (7, 0))
+
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+
+        return base_image
+
+class Limit8ShadingRenderer(FloorShadingRenderer):
+    def __init__(self, painter: Painter, main_image_fn: str, shading_image_fn: str):
+        self.painter = painter
+        self.main_image = engine.image_load(main_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        limit: Dict[int, int] = {k: find_limit8(self.main_image, k) for k in range(self.main_image.get_width() // 8)}
+        self.painter.set_limit(limit)
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        regular_coords, shading_coord = self.painter.get_coord(dungeon_tilemap, position)
+        coord1, coord2, coord3, coord4 = regular_coords
+
+        base_image = engine.create_surface((16, 16))
+        base_image.blit(get_image8(self.main_image, coord1), (0, 0))
+        base_image.blit(get_image8(self.main_image, coord2), (8, 0))
+        base_image.blit(get_image8(self.main_image, coord3), (8, 8))
+        base_image.blit(get_image8(self.main_image, coord4), (0, 8))
+
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        pillar_coord = self.painter.get_pillar_coord(dungeon_tilemap, position)
+        if pillar_coord:
+            extra_image = get_image16(self.shading_image, pillar_coord)
+        elif self.painter.is_column_bottom(dungeon_tilemap, position):
+            extra_image = get_image16(self.shading_image, (7, 0))
+
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+
+        return base_image
+
+class Limit16ShadingRenderer(FloorShadingRenderer):
+    def __init__(self, painter: Painter, main_image_fn: str, shading_image_fn: str):
+        self.painter = painter
+        self.main_image = engine.image_load(main_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        limit: Dict[int, int] = {k: find_limit16(self.main_image, k) for k in range(self.main_image.get_width() // 16)}
+        self.painter.set_limit(limit)
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        coord, shading_coord = self.painter.get_coord(dungeon_tilemap, position)
+
+        base_image = get_image16(self.main_image, coord)
+
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        pillar_coord = self.painter.get_pillar_coord(dungeon_tilemap, position)
+        if pillar_coord:
+            extra_image = get_image16(self.shading_image, pillar_coord)
+        elif self.painter.is_column_bottom(dungeon_tilemap, position):
+            extra_image = get_image16(self.shading_image, (7, 0))
+
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+
+        return base_image
diff --git a/app/dungeon_maker/pygame_renderers/simple_renderer.py b/app/dungeon_maker/pygame_renderers/simple_renderer.py
new file mode 100644
index 000000000..720c6d3a5
--- /dev/null
+++ b/app/dungeon_maker/pygame_renderers/simple_renderer.py
@@ -0,0 +1,18 @@
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.pygame_renderers.renderer_utils import find_limit16, get_image16
+from app.engine import engine
+
+class SimpleRenderer:
+    def __init__(self, painter: Painter, image_fn: str):
+        self.painter = painter
+        self.image = engine.image_load(image_fn)
+        limit = find_limit16(self.image, 0)
+        self.painter.set_limit({0: limit})
+
+    def determine_sprite(self, dungeon_tilemap: DungeonTileMap, 
+                         position: Pos) -> engine.Surface:
+        coord = self.painter.get_coord(dungeon_tilemap, position)
+        return get_image16(self.image, coord)
