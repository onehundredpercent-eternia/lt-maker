diff --git a/app/dungeon_maker/encounter_generation.py b/app/dungeon_maker/encounter_generation.py
new file mode 100644
index 000000000..d8b983c7d
--- /dev/null
+++ b/app/dungeon_maker/encounter_generation.py
@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+from typing import List, Set, Tuple, TYPE_CHECKING
+from dataclasses import dataclass, field
+
+from app.constants import TILEWIDTH, TILEHEIGHT
+
+from app.utilities.typing import NID, Pos
+from app.utilities import utils, static_random
+from app.utilities.static_random import LCG
+
+from app.events import regions
+
+from app.engine import action, engine
+from app.engine.objects.tilemap import TileMapObject, LayerObject
+from app.engine.objects.region import RegionObject
+
+from app.dungeon_maker import enemy_encounters
+
+
+if TYPE_CHECKING:
+    from app.dungeon_maker.terrain_generation import DungeonTileMap
+
+@dataclass
+class EncounterRequirements:
+    min_width: int = None
+    max_width: int = None
+    min_height: int = None
+    max_height: int = None
+    invalid_themes: List[NID] = field(default_factory=list)
+    min_floor_level: int = None
+    max_floor_level: int = None
+
+    def meets(self, width: int, height: int, theme: NID, floor_level: int) -> bool:
+        valid = True
+
+        # Check room size
+        if self.min_width is not None:
+            valid &= (width >= self.min_width)
+        if self.max_width is not None:
+            valid &= (width <= self.max_width)
+        if self.min_height is not None:
+            valid &= (height >= self.min_height)
+        if self.max_height is not None:
+            valid &= (height <= self.max_height)
+
+        # Check theme
+        valid &= (theme not in self.invalid_themes)
+
+        # Check floor level
+        if self.min_floor_level is not None:
+            valid &= (floor_level >= self.min_floor_level)
+        if self.max_floor_level is not None:
+            valid &= (floor_level <= self.max_floor_level)
+
+        return valid
+
+class NonEnemyEncounter:
+    nid: NID
+    requirements: EncounterRequirements
+    weight: float
+
+    @staticmethod
+    def apply(game, rect: Tuple[int, int, int, int], dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, dungeon_palette: str, 
+              enemy_level: int, encounter_uid: int, rng: LCG):
+        pass
+
+class Empty(NonEnemyEncounter):
+    nid: NID = 'empty'
+    requirements: EncounterRequirements = EncounterRequirements()
+    weight: float = 1.0
+
+    @staticmethod
+    def apply(game, rect: Tuple[int, int, int, int], dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, dungeon_palette: str, 
+              enemy_level: int, encounter_uid: int, rng: LCG):
+        pass
+
+class Treasure(NonEnemyEncounter):
+    nid: NID = 'empty'
+    requirements: EncounterRequirements = EncounterRequirements()
+    weight: float = 0.5
+
+    @staticmethod
+    def apply(game, rect: Tuple[int, int, int, int], dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, dungeon_palette: str, 
+              enemy_level: int, encounter_uid: int, rng: LCG):
+        x, y, width, height = rect
+        positions = []
+        for (i, j) in utils.itergrid(width, height):
+            positions.append((x + i, y + j))
+        rng.shuffle(positions)
+        position = next(iter(positions))
+
+        # Add Region
+        x, y = position
+        name = f"Treasure_{x}_{y}"
+        new_region = RegionObject(name, regions.RegionType.EVENT)
+        new_region.position = position
+        new_region.size = (1, 1)
+        new_region.sub_nid = "Chest"
+        new_region.only_once = True
+
+        game.register_region(new_region)
+        action.do(action.AddRegion(new_region))
+
+        # Modify tilemap
+        treasure_im_fn = f'app/dungeon_maker/palettes/{dungeon_palette}/treasure.png'
+        treasure_im = engine.image_load(treasure_im_fn)
+        treasure_sprite = engine.subsurface(treasure_im, (0, 0, 20, 16))
+        open_treasure_sprite = engine.subsurface(treasure_im, (0, 16, 20, 16))
+
+        # Switch terrain & modify base image
+        pixel_pos = (position[0] * TILEWIDTH, position[1] * TILEHEIGHT)
+        base_layer = tilemap.layers[0]
+        base_layer.terrain[position] = "Chest"
+        base_layer.image.blit(treasure_sprite, pixel_pos)
+
+        # Now create a new layer
+        treasure_layer = LayerObject(name, False, tilemap)
+        treasure_layer.visible = False
+        treasure_layer.set_image(open_treasure_sprite)
+        treasure_layer.pixel_bounds = [pixel_pos[0], pixel_pos[1], pixel_pos[0] + 20, pixel_pos[1] + 16]
+        tilemap.layers.append(treasure_layer)
+
+
+def _place_enemies(game, dungeon_theme: NID, dungeon_tilemap: DungeonTileMap, 
+                   tilemap: TileMapObject, enemy_level: int, enemy_budget: float, 
+                   enemy_tag: str, rng: LCG):
+    START_DISTANCE = 5
+    ENEMY_DISTANCE = 6
+    current_budget: float = enemy_budget
+    valid_enemy_positions: Set[Pos] = set(dungeon_tilemap.get_open_tiles())
+    valid_enemy_positions -= game.target_system.find_manhattan_spheres(range(START_DISTANCE + 1), *dungeon_tilemap.get_start_pos())
+    valid_enemy_positions: List[Pos] = list(sorted(valid_enemy_positions))
+    encounter_uid = 0
+    while current_budget > 0 and valid_enemy_positions:
+        # Pick a random enemy encounter type
+        idx = static_random.weighted_choice([e.weight for e in enemy_encounters.ENEMY_ENCOUNTERS], rng)
+        enemy_encounter_type = enemy_encounters.ENEMY_ENCOUNTERS[idx]
+        # Pick a random point on the tilemap that's far away from other enemies / players
+        pos = rng.choice(valid_enemy_positions)
+        print(f"Enemy Position: {pos}")
+        positions, cost = enemy_encounter_type.apply(
+                game, pos, dungeon_tilemap, 
+                tilemap, enemy_level, encounter_uid, enemy_tag, rng)
+        print(f"Enemy Positions: {positions}")
+
+        # Remove the positions near this group as valid
+        valid_enemy_positions = set(valid_enemy_positions)
+        for position in positions:
+            nearby = game.target_system.find_manhattan_spheres(range(ENEMY_DISTANCE + 1), *position)
+            valid_enemy_positions -= nearby
+        valid_enemy_positions = list(sorted(valid_enemy_positions))
+
+        current_budget -= cost
+        print(f"Type: {enemy_encounter_type}, Cost: {cost}, Remaining Budget: {current_budget}, Remaining Enemy Positions: {len(valid_enemy_positions)}")
+
+def place_encounters(game, dungeon_tilemap: DungeonTileMap, tilemap: TileMapObject,
+                     enemy_level: int, floor_level: int, dungeon_theme: NID, 
+                     enemy_tag: str, dungeon_palette: str, seed: int):
+    rng = static_random.LCG(seed)
+    num_open_tiles = len(dungeon_tilemap.get_open_tiles())
+    enemy_budget = 0.5 * (32 / 148) * num_open_tiles * (1 + enemy_level * 0.1) * (1 + floor_level * 0.1)
+    print(f"Enemy Budget: {enemy_budget}")
+    # Non-enemies
+    for idx, section in enumerate(dungeon_tilemap.sections.values()):
+        if section.has_full_room():
+            valid_encounters = [e for e in ENCOUNTERS if e.requirements.meets(section.room.width, section.room.height, dungeon_theme, floor_level)]
+            encounter_idx: int = static_random.weighted_choice([e.weight for e in valid_encounters], rng)
+            encounter = valid_encounters[encounter_idx]
+            encounter.apply(game, section.room.get_rect(), dungeon_tilemap, tilemap, dungeon_palette, enemy_level, idx, rng)
+    # Enemies
+    _place_enemies(game, dungeon_theme, dungeon_tilemap, tilemap, enemy_level, enemy_budget, enemy_tag, rng)
+
+ENCOUNTERS = [
+    Empty,
+    Treasure,
+]
diff --git a/app/dungeon_maker/enemy_encounters.py b/app/dungeon_maker/enemy_encounters.py
new file mode 100644
index 000000000..a129d9dc8
--- /dev/null
+++ b/app/dungeon_maker/enemy_encounters.py
@@ -0,0 +1,330 @@
+from __future__ import annotations
+
+from typing import List, Tuple, TYPE_CHECKING
+from dataclasses import dataclass
+from app.utilities.typing import NID, Pos
+from app.utilities import utils, str_utils
+from app.utilities.static_random import LCG
+
+from app.data.database.database import DB
+from app.data.database.level_units import GenericUnit
+
+from app.engine import action
+from app.engine.objects.tilemap import TileMapObject
+from app.engine.objects.unit import UnitObject
+from app.data.database.items import ItemPrefab
+
+if TYPE_CHECKING:
+    from app.dungeon_maker.terrain_generation import DungeonTileMap
+
+def calculate_cost(unit: UnitObject) -> float:
+    k = DB.classes.get(unit.klass)
+    if 'LowLevel' in k.tags:
+        return 0.75
+    elif 'MidLevel' in k.tags:
+        return 1
+    elif 'HighLevel' in k.tags:
+        return 1.5
+    else:
+        return 1
+
+def convert_level_to_item_tier(level: int) -> str:
+    if 1 <= level <= 5:
+        return 'Bronze'
+    elif 6 <= level <= 12:
+        return 'Iron'
+    elif 13 <= level <= 19:
+        return 'Steel'
+    elif 20 <= level <= 32:
+        return 'Silver'
+    else:
+        return 'Mithril'
+
+def get_items(game, klass: NID, level: int, rng: LCG) -> List[NID]:
+    """
+    Returns list of items unit should start with
+    """
+    klass_prefab = DB.classes.get(klass)
+    tier = convert_level_to_item_tier(level)
+
+    # Figure out what kind of weapon this unit can wield
+    usable_weapon_types: List[NID] = []
+    for nid, wexp_gain in klass_prefab.wexp_gain.items():
+        if wexp_gain.usable and nid in DB.weapons.keys():
+            usable_weapon_types.append(nid)
+
+    weapon_type = rng.choice(usable_weapon_types)
+
+    def is_weapon_type(item: ItemPrefab, weapon_type: NID):
+        return (item.weapon_type and item.weapon_type.value == weapon_type) \
+            or (item.item_prefab and DB.items.get(item.item_prefab.value).weapon_type 
+                and DB.items.get(item.item_prefab.value).weapon_type.value == weapon_type)
+
+    item_prefabs = DB.items.values()
+    print(tier, weapon_type)
+    item_prefabs = [
+        i for i in item_prefabs 
+        if is_weapon_type(i, weapon_type)
+        and i.item_tags
+        and tier in i.item_tags.value
+    ]
+
+    assert len(item_prefabs) > 0
+    primary = rng.choice(item_prefabs)
+    return [primary.nid]
+
+def create_unit(game, klass: NID, level: int, ai_group: NID, rng: LCG) -> UnitObject:
+    """
+    Given a desired unit's class, level, and ai_group,
+    creates and returns the newly created unit
+    """
+    unit_nid = str_utils.get_next_int('201', [unit.nid for unit in game.units])
+    items: List[NID] = get_items(game, klass, level, rng)
+    unit_prefab = GenericUnit(unit_nid, None, level, klass, "Enemy", items, [], "enemy", "Defend", ai_group=ai_group)
+    unit = UnitObject.from_prefab(unit_prefab, game.current_mode)
+    unit.party = game.current_party
+    return unit
+
+def get_valid_classes(level: int, tag: str) -> List[NID]:
+    if level <= 4:
+        level_tags = ["LowLevel",]
+    elif level <= 10:
+        level_tags = ["LowLevel", "MidLevel"]
+    else:
+        level_tags = ["LowLevel", "MidLevel", "HighLevel"]
+
+    klasses = []
+    for klass in DB.classes:
+        if any(t in klass.tags for t in level_tags) and tag in klass.tags:
+            klasses.append(klass.nid)
+    return klasses
+
+@dataclass
+class EnemyEncounter:
+    nid: NID
+    weight: float
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG):
+        pass
+
+@dataclass
+class Basic(EnemyEncounter):
+    nid = "basic"
+    weight = 0.3
+    num_units = 4
+    nearby = 3
+
+    affix_unit_chance = 0.5
+    affix_classes = [
+        "Archer",
+        "Cleric",
+        "Mage",
+        "Seeress",
+        "Sorceror",
+        "Thief",
+        "Sentinel",
+    ]
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG) -> Tuple[List[Pos], float]:
+        """
+        Places the enemy encounter on the map
+        Returns the positions placed at, plus the cost
+        """
+        klass = rng.choice(get_valid_classes(enemy_level, tag))
+
+        # Place units on board
+        valid_positions = [p for p in dungeon_tilemap.get_open_tiles() if utils.calculate_distance(p, pos) <= Basic.nearby]
+        rng.shuffle(valid_positions)
+        all_positions = iter(valid_positions)
+
+        used_positions: List[Pos] = []
+        total_cost: float = 0
+        for _ in range(Basic.num_units):
+            position = next(all_positions)
+            unit = create_unit(game, klass, enemy_level, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += calculate_cost(unit)
+
+        # Affix unit
+        if rng.random() < Basic.affix_unit_chance:
+            affix_klass = rng.choice(Basic.affix_classes)
+            position = next(all_positions)
+            unit = create_unit(game, affix_klass, enemy_level, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += calculate_cost(unit)
+
+        return used_positions, total_cost
+
+
+@dataclass
+class TwoTypes(EnemyEncounter):
+    nid = "two_types"
+    weight = 0.3
+    num_units = 6
+    nearby = 4
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG) -> Tuple[List[Pos], float]:
+        klasses = get_valid_classes(enemy_level, tag).copy()
+        klass1 = rng.choice(klasses)
+        klasses.remove(klass1)
+        klass2 = rng.choice(klasses)
+
+        # Place units on board
+        valid_positions = [p for p in dungeon_tilemap.get_open_tiles() if utils.calculate_distance(p, pos) <= TwoTypes.nearby]
+        rng.shuffle(valid_positions)
+        all_positions = iter(valid_positions)
+
+        used_positions: List[Pos] = []
+        total_cost: float = 0
+        for idx in range(TwoTypes.num_units):
+            if idx % 2 == 1:
+                klass = klass2
+            else:
+                klass = klass1
+            position = next(all_positions)
+            unit = create_unit(game, klass, enemy_level, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += calculate_cost(unit)
+
+        return used_positions, total_cost
+
+@dataclass
+class Leader(EnemyEncounter):
+    nid = "leader"
+    weight = 0.3
+    nearby = 3
+    num_units = 4
+
+    leader_classes = [
+        "Archer",
+        "Sorceror",
+        "Mercenary",
+        "Myrmidon",
+        "Sentinel",
+        "Dracoknight",
+        "Falcoknight",
+    ]
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG) -> Tuple[List[Pos], float]:
+        klass = rng.choice(get_valid_classes(enemy_level, tag))
+        leader_klass = rng.choice(Leader.leader_classes)
+
+        # Place units on board
+        valid_positions = [p for p in dungeon_tilemap.get_open_tiles() if utils.calculate_distance(p, pos) <= Leader.nearby]
+        rng.shuffle(valid_positions)
+        all_positions = iter(valid_positions)
+
+        used_positions: List[Pos] = []
+        total_cost: float = 0
+        for idx in range(Leader.num_units):
+            position = next(all_positions)
+            unit = create_unit(game, klass, enemy_level, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += calculate_cost(unit)
+
+        # Place leader 5 levels ahead
+        position = next(all_positions)
+        unit = create_unit(game, leader_klass, enemy_level + 5, encounter_uid, rng)
+        action.do(action.RegisterUnit(unit))
+        action.do(action.ArriveOnMap(unit, position))
+        used_positions.append(position)
+        total_cost += 2 * calculate_cost(unit)
+
+        return used_positions, total_cost
+
+@dataclass
+class Elite(EnemyEncounter):
+    nid = "elite"
+    weight = 0.3
+    nearby = 3
+    num_units = 3
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG) -> Tuple[List[Pos], float]:
+        klass = rng.choice(get_valid_classes(enemy_level, tag))
+
+        # Place units on board
+        valid_positions = [p for p in dungeon_tilemap.get_open_tiles() if utils.calculate_distance(p, pos) <= Elite.nearby]
+        rng.shuffle(valid_positions)
+        all_positions = iter(valid_positions)
+
+        used_positions: List[Pos] = []
+        total_cost: float = 0
+        for idx in range(Elite.num_units):
+            position = next(all_positions)
+            unit = create_unit(game, klass, enemy_level + 2, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += 2 * calculate_cost(unit)
+
+        return used_positions, total_cost
+
+@dataclass
+class Weak(EnemyEncounter):
+    nid = "weak"
+    weight = 0.1
+    num_units = 8
+    nearby = 5
+
+    weak_classes = [
+        "Soldier",
+        "Raider",
+    ]
+
+    @staticmethod
+    def apply(game, pos: Pos, dungeon_tilemap: DungeonTileMap, 
+              tilemap: TileMapObject, enemy_level: int, encounter_uid: int, 
+              tag: str, rng: LCG) -> Tuple[List[Pos], float]:
+        """
+        Places the enemy encounter on the map
+        Returns the positions placed at, plus the cost
+        """
+        klass = rng.choice(Weak.weak_classes)
+
+        # Place units on board
+        valid_positions = [p for p in dungeon_tilemap.get_open_tiles() if utils.calculate_distance(p, pos) <= Weak.nearby]
+        rng.shuffle(valid_positions)
+        all_positions = iter(valid_positions)
+
+        used_positions: List[Pos] = []
+        total_cost: float = 0
+        for _ in range(Weak.num_units):
+            position = next(all_positions)
+            unit = create_unit(game, klass, enemy_level - 2, encounter_uid, rng)
+            action.do(action.RegisterUnit(unit))
+            action.do(action.ArriveOnMap(unit, position))
+            used_positions.append(position)
+            total_cost += calculate_cost(unit)
+
+        return used_positions, total_cost
+
+ENEMY_ENCOUNTERS = [
+    Basic,
+    TwoTypes,
+    Leader,
+    Elite,
+    Weak,
+]
