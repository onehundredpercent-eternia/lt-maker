index 000000000..ad4f92d4e
--- /dev/null
+++ b/utilities/archived_code/west_march/value_noise.py
@@ -0,0 +1,21 @@
+import glob
+
+from app.engine import engine
+
+class ValueNoise():
+    transparency = 16  # 0 - 255 (opaque)
+    speed = 50  # ms
+
+    def __init__(self):
+        self.ims = [engine.image_load(im) for im in glob.glob('fog/im*.png')]
+        self.reset_transparency()
+
+    def reset_transparency(self):
+        for im in self.ims:
+            im.set_alpha(self.transparency)
+
+    def draw(self, surf):
+        pz = int(engine.get_time() // self.speed) % len(self.ims)
+        im = self.ims[pz]
+        surf.blit(im, (0, 0))
+        return surf
diff --git a/utilities/palette_converter.py b/utilities/palette_converter.py
new file mode 100644
index 000000000..f75b90929
--- /dev/null
+++ b/utilities/palette_converter.py
@@ -0,0 +1,78 @@
+import colorsys
+from PIL import Image, ImageColor
+
+loc = './'
+
+im = r'C:\Users\Patrick\Documents\Github\memento-mori\extra_resources\Portraits\Anna.png'
+
+def hsv2rgb(h: float, s: float, v: float) -> tuple:
+    return tuple(round(i * 255) for i in colorsys.hsv_to_rgb(h, s, v))
+
+def rgb2hsv(r: int, g: int, b: int) -> tuple:
+    return tuple(colorsys.rgb_to_hsv(r, g, b))
+
+def clamp(i, bound_a, bound_b):
+    max_ = max(bound_a, bound_b)
+    min_ = min(bound_a, bound_b)
+    return min(max_, max(min_, i))
+
+def lerp(a: float, b: float, t: float) -> float:
+    """Linear interpolation
+
+    Args:
+        a, b (float): values to lerp between
+        t (float): time or proportion to lerp for, must be in range [0, 1]
+
+    Returns:
+        [float]: lerped value
+    """
+    t = clamp(t, 0, 1)
+    return (b - a) * t + a
+
+def change_saturation(value):
+    return lerp(2.0, 0.8, value)
+
+def change_value(value):
+    return lerp(0.3, 0.8, value)
+
+colors = ['#0d2b45', '#203c56', '#544e68', '#8d697a', '#d08159', '#ffaa5e', '#ffd4a3', '#ffecd6']
+colors = [ImageColor.getcolor(c, "RGB") for c in colors]
+hue = [rgb2hsv(*c)[0] for c in colors]
+saturation = [rgb2hsv(*c)[1] for c in colors]
+values = [rgb2hsv(*c)[2]/255 for c in colors]
+print(hue)
+print(saturation)
+print(values)
+
+def transform_color(color):
+    h, s, v = rgb2hsv(*color[:3])
+    value = v / 255
+    if color[:3] == (128, 160, 128):
+        return color[:3]
+    if value < .28:
+        return colors[0]
+    elif value < .43:
+        return colors[1]
+    elif value < .58:
+        return colors[2]
+    elif value < .68:
+        return colors[3]
+    elif value < .78:
+        return colors[4]
+    elif value < .88:
+        return colors[5]
+    elif value < .98:
+        return colors[6]
+    else:
+        return colors[7]
+
+def convert_palette(im):
+    width, height = im.size
+    for x in range(width):
+        for y in range(height):
+            color = im.getpixel((x, y))
+            new_color = transform_color(color)
+            im.putpixel((x, y), new_color)
+    return im
+
+convert_palette(Image.open(im)).convert('RGB').save(im)
diff --git a/utilities/sprite_tween_set_notes.txt b/utilities/sprite_tween_set_notes.txt
new file mode 100644
index 000000000..ccdfe887f
--- /dev/null
+++ b/utilities/sprite_tween_set_notes.txt
@@ -0,0 +1,77 @@
+I wrote up some brainstorming notes on how I envision the API changing for something simpler than unit sprites (placing sprite_sets/animations on the tilemap). Obviously not final...
+
+Current API for display animations on the map (explosions, etc.):
+
+```python
+game.tilemap.animations = [anim for anim in game.tilemap.animations if not anim.update()]
+        for anim in game.tilemap.animations:
+            anim.draw(surf, offset=(-game.camera.get_x(), -game.camera.get_y()))
+```
+
+Refactor:
+
+```python
+game.tilemap.sprite_tween_sets = {pos: sts for pos, sts in game.tilemap.sprite_tween_sets.items() if sts.update()]
+offset = -game.camera.get_x(), -game.camera.get_y()
+for pos, sts in game.tilemap.sprite_tween_sets:
+    sts.draw(surf, utils.tuple_add(pos, offset))
+```
+
+```python
+class SpriteTweenSet():
+    def __init__(self, prefab):
+        self.nid = prefab.nid
+
+        # Load images
+        self.full_image = engine.image_load(prefab.full_path)
+        self.full_image = self.full_image.convert_alpha()
+        width = self.full_image.get_width() // prefab.frame_x
+        height = self.full_image.get_height() // prefab.frame_y
+        self.images = [engine.subsurface(self.full_image, (i % prefab.frame_x, i // prefab.frame_x, width, height))][:prefab.num_images]
+
+        self.current_idx = 0
+        self.current_image = self.images[self.current_idx].copy()
+
+        self.offset = (0, 0)
+        self.tweens = []
+        self.parent: SpriteTweenSet = None
+        self.kill_me = False
+
+    def get_image(self):
+        return self.current_image
+
+    def add_tween(self, tween):
+        self.tweens.append(tween)
+
+    def update(self):
+        self.tweens = [tween for tween in self.tweens if tween.update()]
+
+    def draw(self, surf, pos):
+        if self.parent:
+            pos = utils.tuple_add(pos, self.parent.offset)
+        pos = utils.tuple_add(pos, self.offset)
+        surf.blit(self.current_image, pos)
+```
+
+```python
+class AddMapSpriteSet(Action):
+    def __init__(self, nid, pos):
+        self.nid = nid
+        self.pos = pos
+
+    def do(self):
+        sprite_set_prefab = RESOURCES.sprite_sets.get(self.nid)
+        sprite_tween_set = tween.SpriteTweenSet(sprite_set_prefab)
+        
+        # Let's say this animation should be tinted 
+        permanently, vibrate, and fade in at the beginning
+        # Still question on how the game designer chooses these tweens without being in code.
+
+        # Tweens register themselves with the sprite_tween_set
+        anim_tween = tween.Animate(sprite_tween_set, speed=5, loop=True)
+        tint_tween = tween.TintColor(sprite_tween_set, (200, 0, 200))
+        vibrate_tween = tween.Vibrate(sprite_tween_set, (1, 1))
+        fade_in_tween = tween.FadeIn(sprite_tween_set, frames=20, curve=tween.Curve.Linear)
+
+        game.tilemap.sprite_tween_set[pos] = sprite_tween_set
+```
