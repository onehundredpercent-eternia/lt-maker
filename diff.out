-                if banner_flag:
-                    game.alerts.append(banner.AcquiredItem(unit, item))
-                    game.state.change('alert')
-                    self.state = 'paused'
-        else:
-            action.do(action.PutItemInConvoy(item))
-            if banner_flag:
