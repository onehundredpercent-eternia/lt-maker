-            state = 'growths'
-        else:
-            state = 'personal_data'
-
-        menu_size = WINWIDTH - 96, WINHEIGHT
-        surf = engine.create_surface(menu_size, transparent=True)
-
-        for idx, stat_nid in enumerate(self.left_stats):
-            curr_stat = DB.stats.get(stat_nid)
