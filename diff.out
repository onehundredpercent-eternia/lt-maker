+    orig_posture: int  # Original posture
+    stagger: int  # attempted stagger damage
+    new_posture: int  # New posture
+
+
+@dataclass
+class PostureBreak(PlaybackBrush):
+    """
+    Added to playback when an attack is breaks a unit's posture
+    """
