-def __getattr__(name):
-    if name == 'input_manager':
-        return INPUT
-    raise AttributeError(f"module '{__name__}' has no attribute '{name}'")
+INPUT: InputManager = None
+def get_input_manager() -> InputManager:
+    global INPUT
+    if not INPUT:
+        INPUT = InputManager()
+    return INPUT
