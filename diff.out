-            return
-
-        s_list = values[1].split(',')
-        stat_changes = {}
-        for idx in range(len(s_list)//2):
-            stat_nid = s_list[idx*2]
-            stat_value = int(s_list[idx*2 + 1])
-            stat_changes[stat_nid] = stat_value
-
-        self._apply_stat_changes(unit, stat_changes, flags)
