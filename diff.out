diff --git a/app/dungeon_maker/painters/floor_painter.py b/app/dungeon_maker/painters/floor_painter.py
new file mode 100644
index 000000000..f8f6f8649
--- /dev/null
+++ b/app/dungeon_maker/painters/floor_painter.py
@@ -0,0 +1,82 @@
+from typing import Optional, Tuple
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.utilities import random_choice
+from app.dungeon_maker.painters.wall_painter import WallBottomPainter
+
+class FloorPainter(Painter):
+    """
+    Selects the correct painter coordinate for the tile by determining
+    what kind of shading should be painted on the floor.
+    For instance, if a wall is to the left of this floor tile, the painter
+    will select a tile that has shading on the left to make the shadow appear
+    """
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        coord = random_choice([(0, k) for k in range(self.limit[0])], pos)
+        return coord
+
+    @staticmethod
+    def is_column_bottom(dungeon_tilemap: DungeonTileMap, pos: Pos) -> bool:
+        """
+        Returns whether the position is the bottom of a wall column
+        """
+        north, _, _, _ = dungeon_tilemap.get_cardinal_terrain(pos)
+        if north == Terrain.WALL_BOTTOM and WallBottomPainter.is_a_column(dungeon_tilemap, (pos[0], pos[1] - 1)):
+            return True
+        return False
+
+    @staticmethod
+    def get_pillar_coord(dungeon_tilemap: DungeonTileMap, pos: Pos) -> Optional[Pos]:
+        """
+        Returns coordinate on shading tileset for the bottom of the pillar
+        """
+        north, _, _, _ = dungeon_tilemap.get_cardinal_terrain(pos)
+        _, left, corner = FloorPainter.get_shading(dungeon_tilemap, pos)
+        if north == Terrain.PILLAR:
+            if left or corner:
+                return (6, 0)
+            else:
+                return (5, 0)
+        return None
+
+    @staticmethod
+    def get_shading(dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[bool, bool, bool]:
+        north, _, _, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        _, _, _, northwest = dungeon_tilemap.get_diagonal_terrain(pos)
+        top, left, corner = False, False, False
+
+        if north in (Terrain.WALL_TOP, Terrain.WALL_BOTTOM):
+            top = True
+        if west in (Terrain.WALL_TOP, Terrain.WALL_BOTTOM):
+            left = True
+        if northwest == Terrain.PILLAR:
+            corner = True
+        if west == Terrain.PILLAR:
+            left = True
+        if west == Terrain.STAIRS_LEFT and northwest in (Terrain.WALL_TOP, Terrain.WALL_BOTTOM):
+            corner = True
+        if northwest in (Terrain.WALL_TOP, Terrain.WALL_BOTTOM) \
+                and west in (Terrain.FLOOR_LOWER, Terrain.FLOOR_UPPER) \
+                and FloorPainter.is_column_bottom(dungeon_tilemap, (pos[0] - 1, pos[1])):
+            corner = True
+        return top, left, corner
+
+    def get_shading_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        top, left, corner = FloorPainter.get_shading(dungeon_tilemap, pos)
+
+        shading_coord = None
+        if top and left:
+            shading_coord = (3, 0)
+        elif top and corner:
+            shading_coord = (4, 0)
+        elif left:
+            shading_coord = (0, 0)
+        elif corner:
+            shading_coord = (2, 0)
+        elif top:
+            shading_coord = (1, 0)
+
+        return shading_coord
diff --git a/app/dungeon_maker/painters/forest_painter.py b/app/dungeon_maker/painters/forest_painter.py
new file mode 100644
index 000000000..e11fcfebe
--- /dev/null
+++ b/app/dungeon_maker/painters/forest_painter.py
@@ -0,0 +1,54 @@
+from app.utilities.typing import Pos
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+
+class SparseForestPainter(Painter):
+
+class ForestPainter(Painter):
+    terrain_like = (Terrain.SPARSE_FOREST, Terrain.FOREST, Terrain.THICKET)
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        north, east, south, west = tilemap.get_cardinal_terrain(pos)
+        blob_positions = flood_fill(tilemap, pos)
+
+        _, _, _, _, blob_width, blob_height, center_x, center_y = \
+            find_bounds(tilemap, blob_positions)
+        my_radius_width = abs(pos[0] + 0.5 - center_x)
+        my_radius_height = abs(pos[1] + 0.5 - center_y)
+        depth_w = (blob_width / 2) - my_radius_width
+        depth_h = (blob_height / 2) - my_radius_height
+        chance_w = utils.lerp(1, 0, depth_w/4)
+        chance_h = utils.lerp(1, 0, depth_h/4)
+        chance_to_lose_adjacent_edges = utils.clamp(max(chance_w, chance_h), 0, 1)
+
+        north_edge = bool(north and north not in self.forest_like)  # Whether we don't border a forest
+        if not north_edge and north and north != 'Thicket':  # We border a forest
+            north_edge = (edge_random((pos[0], pos[1] - 1), pos) < chance_to_lose_adjacent_edges)
+        east_edge = bool(east and east not in self.forest_like)
+        if not east_edge and east and east != 'Thicket':  # We border a forest
+            east_edge = (edge_random(pos, (pos[0] + 1, pos[1])) < chance_to_lose_adjacent_edges)
+        south_edge = bool(south and south not in self.forest_like)
+        if not south_edge and south and south != 'Thicket':  # We border a forest
+            south_edge = (edge_random(pos, (pos[0], pos[1] + 1)) < chance_to_lose_adjacent_edges)
+        west_edge = bool(west and west not in self.forest_like)
+        if not west_edge and west and west != 'Thicket':  # We border a forest
+            west_edge = (edge_random((pos[0] - 1, pos[1]), pos) < chance_to_lose_adjacent_edges)
+        
+        total_index = \
+            north_edge + 2 * east_edge + 4 * south_edge + 8 * west_edge
+        index1 = north_edge + 8 * west_edge
+        index2 = north_edge + 2 * east_edge
+        index3 = 4 * south_edge + 2 * east_edge
+        index4 = 4 * south_edge + 8 * west_edge
+        if total_index == 15 and random_choice([1, 2, 3], pos) != 3:  # When by itself
+            new_coord1 = (14, 0)
+            new_coord2 = (15, 0)
+            new_coord3 = (15, 1)
+            new_coord4 = (14, 1)
+        else:
+            new_coord1 = (index1, {0: 0, 1: 0, 8: 0, 9: 0}[index1])
+            new_coord2 = (index2, {0: 1, 1: 1, 2: 0, 3: 0}[index2])
+            new_coord3 = (index3, {0: 3, 2: 1, 4: 1, 6: 0}[index3])
+            new_coord4 = (index4, {0: 2, 4: 0, 8: 1, 12: 0}[index4])
+        
+        pix = self.get_pixmap8(new_coord1, new_coord2, new_coord3, new_coord4, autotile_num)
+        return pix
diff --git a/app/dungeon_maker/painters/grass_painter.py b/app/dungeon_maker/painters/grass_painter.py
new file mode 100644
index 000000000..1c1e90ae3
--- /dev/null
+++ b/app/dungeon_maker/painters/grass_painter.py
@@ -0,0 +1,73 @@
+from typing import Dict, Tuple
+
+from app.utilities.typing import Pos
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.painters.floor_painter import FloorPainter
+from app.dungeon_maker.painters.noise_interface import NoiseInterface
+from app.dungeon_maker.utilities import random_choice
+from app.dungeon_maker.terrain import Terrain
+
+class GrassPainter(NoiseInterface, FloorPainter):
+    """
+    # Implements 8x8 Floor with Grass
+    """
+    noise_vertices: Dict[Pos, bool] = {}
+    noise_threshold: float = 0.55
+
+    def get_index(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[int, int, int, int]:
+        center = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 1), False) 
+        north = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2), False)
+        east = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 1), False)
+        south = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 2), False)
+        west = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 1), False)
+        northwest = self.noise_vertices.get((pos[0]*2, pos[1]*2), False)
+        northeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2), False)
+        southwest = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 2), False)
+        southeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 2), False)
+
+        # since it doesn't look good, make sure the green sections don't overlap
+        # the forest tiles
+        n, e, s, w = dungeon_tilemap.get_cardinal_terrain(pos)
+        ne, se, sw, nw = dungeon_tilemap.get_diagonal_terrain(pos)
+        north &= (all(k != Terrain.SPARSE_FOREST for k in (n, ne, nw, e, w)))
+        east &= (all(k != Terrain.SPARSE_FOREST for k in (e, ne, se, s, n)))
+        south &= (all(k != Terrain.SPARSE_FOREST for k in (s, se, sw, e, w)))
+        west &= (all(k != Terrain.SPARSE_FOREST for k in (w, nw, sw, s, n)))
+        northeast &= (all(k != Terrain.SPARSE_FOREST for k in (ne, n, e)))
+        southeast &= (all(k != Terrain.SPARSE_FOREST for k in (se, s, e)))
+        southwest &= (all(k != Terrain.SPARSE_FOREST for k in (sw, s, w)))
+        northwest &= (all(k != Terrain.SPARSE_FOREST for k in (nw, n, w)))
+        center &= (all(k != Terrain.SPARSE_FOREST for k in (n, e, s, w)))
+
+        # Topleft
+        index1 = 1 * north + \
+            2 * center + \
+            4 * west + \
+            8 * northwest
+        # Topright
+        index2 = 1 * northeast + \
+            2 * east + \
+            4 * center + \
+            8 * north
+        # Bottomright
+        index3 = 1 * east + \
+            2 * southeast + \
+            4 * south + \
+            8 * center
+        # Bottomleft
+        index4 = 1 * center + \
+            2 * south + \
+            4 * southwest + \
+            8 * west
+        return index1, index2, index3, index4
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[Tuple[Pos, Pos, Pos, Pos], Pos]:
+        index1, index2, index3, index4 = self.get_index(dungeon_tilemap, pos)
+        coord1 = random_choice([(index1, k) for k in range(self.limit[index1])], (pos[0] * 2, pos[1] * 2))
+        coord2 = random_choice([(index2, k) for k in range(self.limit[index2])], (pos[0] * 2 + 1, pos[1] * 2))
+        coord3 = random_choice([(index3, k) for k in range(self.limit[index3])], (pos[0] * 2 + 1, pos[1] * 2 + 1))
+        coord4 = random_choice([(index4, k) for k in range(self.limit[index4])], (pos[0] * 2, pos[1] * 2 + 1))
+
+        shading_coord = self.get_shading_coord(dungeon_tilemap, pos)
+
+        return ((coord1, coord2, coord3, coord4), shading_coord)
diff --git a/app/dungeon_maker/painters/noise_interface.py b/app/dungeon_maker/painters/noise_interface.py
new file mode 100644
index 000000000..c1d796e38
--- /dev/null
+++ b/app/dungeon_maker/painters/noise_interface.py
@@ -0,0 +1,16 @@
+from typing import Dict
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.utilities import get_random_seed
+from app.map_maker import simplex_noise
+
+class NoiseInterface:
+    def single_process(self, tilemap: DungeonTileMap):
+        # Generate a noise map and use that to fill the noise_vertices with True or False
+        # depending on threshold
+        seed = get_random_seed()
+        noise_map: Dict[Pos, float] = simplex_noise.gen_noise_map(
+            (tilemap.width * 2 + 1, tilemap.height * 2 + 1), seed,
+            starting_frequency=0.125)
+        self.noise_vertices = {pos: value > self.noise_threshold for pos, value in noise_map.items()}
diff --git a/app/dungeon_maker/painters/random_painter.py b/app/dungeon_maker/painters/random_painter.py
new file mode 100644
index 000000000..ebfb39dc8
--- /dev/null
+++ b/app/dungeon_maker/painters/random_painter.py
@@ -0,0 +1,27 @@
+from __future__ import annotations
+from typing import Tuple, TYPE_CHECKING
+
+from app.utilities.typing import Pos
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.utilities import random_choice
+from app.dungeon_maker.terrain import Terrain
+
+if TYPE_CHECKING:
+    from app.dungeon_maker.terrain_generation import DungeonTileMap
+
+class RandomPainter(Painter):
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        coord = random_choice([(0, k) for k in range(self.limit[0])], pos)
+        return coord
+
+class RandomShadingPainter(Painter):
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[Pos, Pos]:
+        coord = random_choice([(0, k) for k in range(self.limit[0])], pos)
+        
+        # Figure out shading
+        shading_coord = None
+        _, _, _, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        if west in (Terrain.WALL_TOP, Terrain.WALL_BOTTOM, Terrain.PILLAR):
+            shading_coord = (coord[0] + 1, coord[1])
+
+        return coord, shading_coord
diff --git a/app/dungeon_maker/painters/ruins_painter.py b/app/dungeon_maker/painters/ruins_painter.py
new file mode 100644
index 000000000..e9d867fb6
--- /dev/null
+++ b/app/dungeon_maker/painters/ruins_painter.py
@@ -0,0 +1,44 @@
+from typing import Dict, Tuple
+
+from app.utilities.typing import Pos
+from app.dungeon_maker.terrain_generation import DungeonTileMap
+from app.dungeon_maker.painters.floor_painter import FloorPainter
+from app.dungeon_maker.painters.noise_interface import NoiseInterface
+from app.dungeon_maker.utilities import random_choice
+
+class RuinsPainter(NoiseInterface, FloorPainter):
+    """
+    # Implements 16x16 Floor with Ruins
+    """
+    noise_vertices: Dict[Pos, bool] = {}
+    noise_threshold: float = 0.5
+
+    def get_index(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> int:
+        center = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 1), False) 
+        north = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2), False)
+        east = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 1), False)
+        south = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 2), False)
+        west = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 1), False)
+        northwest = self.noise_vertices.get((pos[0]*2, pos[1]*2), False)
+        northeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2), False)
+        southwest = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 2), False)
+        southeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 2), False)
+
+        topleft = center + north + west + northwest >= 3
+        topright = center + north + east + northeast >= 3
+        bottomleft = center + south + west + southwest >= 3
+        bottomright = center + south + east + southeast >= 3
+
+        index = 1 * topright + \
+            2 * bottomright + \
+            4 * bottomleft + \
+            8 * topleft
+        return index
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[Pos, Pos]:
+        index = self.get_index(dungeon_tilemap, pos)
+
+        coord = random_choice([(index, k) for k in range(self.limit[index])], pos)
+        shading_coord = self.get_shading_coord(dungeon_tilemap, pos)
+
+        return coord, shading_coord
diff --git a/app/dungeon_maker/painters/stairs_painter.py b/app/dungeon_maker/painters/stairs_painter.py
new file mode 100644
index 000000000..a83c9594c
--- /dev/null
+++ b/app/dungeon_maker/painters/stairs_painter.py
@@ -0,0 +1,51 @@
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+from app.dungeon_maker.painter_utils import Painter
+
+class StairsUpDownPainter(Painter):
+    """
+    Determines which coordinate should be used for the stairs based
+    on a small set of adjacency rules
+    """
+    terrain_like = (Terrain.STAIRS_UP, Terrain.STAIRS_DOWN)
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        _, east, _, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        left, right = False, False
+        if east not in self.terrain_like:
+            right = True
+        if west not in self.terrain_like:
+            left = True
+
+        if left and right:
+            coord = (0, 0)
+        elif left:
+            coord = (1, 0)
+        elif right:
+            coord = (2, 0)
+        else:
+            coord = (3, 0)
+        return coord
+
+class StairsLeftPainter(Painter):
+    """
+    Determines which coordinate should be used for the stairs based
+    on a small set of adjacency rules
+    """
+    terrain_like = (Terrain.STAIRS_LEFT, )
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        north, _, south, _ = dungeon_tilemap.get_cardinal_terrain(pos)
+        if north not in self.terrain_like:
+            coord = (0, 0)
+        else:
+            coord = (1, 0)
+        return coord
+
+class StairsRightPainter(StairsLeftPainter):
+    """
+    Determines which coordinate should be used for the stairs based
+    on a small set of adjacency rules
+    """
+    terrain_like = (Terrain.STAIRS_RIGHT, )
diff --git a/app/dungeon_maker/painters/wall_painter.py b/app/dungeon_maker/painters/wall_painter.py
new file mode 100644
index 000000000..9e3c92a20
--- /dev/null
+++ b/app/dungeon_maker/painters/wall_painter.py
@@ -0,0 +1,90 @@
+from app.utilities.typing import Pos
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+from app.dungeon_maker.painters import WangEdge2Painter
+from app.dungeon_maker.utilities import random_choice
+
+class WallTopPainter(WangEdge2Painter):
+    terrain_like = (Terrain.WALL_TOP,)
+
+    @staticmethod
+    def get_index(dungeon_tilemap: DungeonTileMap, pos: Pos) -> int:
+        north, east, south, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        north_edge = bool(north in WallTopPainter.terrain_like)
+        south_edge = bool(south in WallTopPainter.terrain_like)
+        east_edge = bool(east in WallTopPainter.terrain_like)
+        west_edge = bool(west in WallTopPainter.terrain_like)
+        index = 1 * north_edge + 2 * east_edge + 4 * south_edge + 8 * west_edge
+        return index
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        index = WallTopPainter.get_index(dungeon_tilemap, pos)
+        ne, se, sw, nw = dungeon_tilemap.get_diagonal_terrain(pos)
+        # Edge is true when we have an adjacent walllike
+        coord = random_choice([(index, k) for k in range(self.limit[index])], pos)
+
+        if index in (12, 13) and sw == Terrain.WALL_TOP:
+            coord = (15, 5)  # Requires walls at at least (W, SW, S)
+        elif index in (6, 7) and se == Terrain.WALL_TOP:
+            coord = (15, 4)  # Requires walls at at least (S, SE, E)
+        elif index in (14, 15) and se == Terrain.WALL_TOP and sw == Terrain.WALL_TOP:
+            coord = (15, 3)  # Requires walls at at least (S, SE, SW, E, W)
+        elif index in (14, 15) and sw == Terrain.WALL_TOP:
+            coord = (14, 5)  # Requires walls at at least (S, SW, E, W)
+        elif index in (14, 15) and se == Terrain.WALL_TOP:
+            coord = (14, 4)  # Requires walls at at least (S, SE, E, W)
+        return coord
+
+class WallBottomPainter(WangEdge2Painter):
+    terrain_like = (Terrain.WALL_TOP, Terrain.WALL_BOTTOM)
+
+    # Used by Floor Painter
+    @staticmethod
+    def is_a_column(dungeon_tilemap: DungeonTileMap, pos: Pos) -> bool:
+        north, east, south, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        if west not in WallBottomPainter.terrain_like and east not in WallBottomPainter.terrain_like:
+            north_pos = (pos[0], pos[1] - 1)
+            # If north has no adjacent friends
+            if north == Terrain.WALL_TOP and WallTopPainter.get_index(dungeon_tilemap, north_pos) == 0:
+                return True
+        return False
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        north, east, south, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        ne, se, sw, nw = dungeon_tilemap.get_diagonal_terrain(pos)
+
+        ends_on_left, ends_on_right, shadow = True, True, False
+        if west in self.terrain_like:
+            ends_on_left = False
+        if east in self.terrain_like:
+            ends_on_right = False
+
+        if west == Terrain.WALL_TOP:
+            shadow = True
+        elif sw in self.terrain_like:
+            shadow = True
+        elif west == Terrain.PILLAR:
+            shadow = True
+
+        if ends_on_left and ends_on_right:
+            north_pos = (pos[0], pos[1] - 1)
+            # If north has no adjacent friends
+            if north == Terrain.WALL_TOP and WallTopPainter.get_index(dungeon_tilemap, north_pos) == 0:
+                index = 6  # Is a column
+            elif shadow:
+                index = 5  # shadowcast on a wall that ends on both right and left
+            else:
+                index = 0  # Wall ends on both right and left
+        elif shadow:
+            if ends_on_right:
+                index = 5  # shadowcast on a wall that ends on right
+            else:
+                index = 4  # Wall has a shadow cast on it
+        elif ends_on_right:
+            index = 2  # Wall ends on the right
+        elif ends_on_left:
+            index = 1  # Wall ends on the left
+        else:
+            index = 3  # Wall does not end on either side
+
+        coord = index, 0
+        return coord
diff --git a/app/dungeon_maker/painters/wang_edge2_painter.py b/app/dungeon_maker/painters/wang_edge2_painter.py
new file mode 100644
index 000000000..2c52bec99
--- /dev/null
+++ b/app/dungeon_maker/painters/wang_edge2_painter.py
@@ -0,0 +1,37 @@
+from typing import Tuple
+from app.utilities.typing import Pos
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.utilities import random_choice
+
+class WangEdge2Painter(Painter):
+    """
+    Selects the correct painter coordinate for the tile by determining which
+    cardinally adjacent tiles are of a similar terrain type.
+    Which column is determined by the method below, and which row is randomized
+    from available rows.
+    0 - No adjacent
+    1 - North
+    2 - East
+    3 - North and East
+    4 - South
+    5 - South and North
+    6 - South and East
+    etc.
+    """
+    terrain_like: Tuple[Terrain] = tuple()
+
+    def _determine_index(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> int:
+        north, east, south, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        north_edge = bool(not north or north in self.terrain_like)
+        south_edge = bool(not south or south in self.terrain_like)
+        east_edge = bool(not east or east in self.terrain_like)
+        west_edge = bool(not west or west in self.terrain_like)
+        index = 1 * north_edge + 2 * east_edge + 4 * south_edge + 8 * west_edge
+        return index
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, position: Pos) -> Pos:
+        col_idx = self._determine_index(dungeon_tilemap, position)
+        coord = random_choice([(col_idx, k) for k in range(self.limit[col_idx])], position)
+        return coord
diff --git a/app/dungeon_maker/painters/water_painter.py b/app/dungeon_maker/painters/water_painter.py
new file mode 100644
index 000000000..cae9ebed6
--- /dev/null
+++ b/app/dungeon_maker/painters/water_painter.py
@@ -0,0 +1,100 @@
+from typing import Tuple
+from app.utilities.typing import Pos
+from app.utilities import utils
+
+from app.dungeon_maker.terrain_generation import DungeonTileMap, Terrain
+from app.dungeon_maker.painter_utils import Painter
+from app.dungeon_maker.utilities import random_choice, random_random
+from app.dungeon_maker.painters.wall_painter import WallBottomPainter
+
+class WaterPainter(Painter):
+    """
+    Selects the correct painter coordinate for the tile by determining
+    what kind of shading should be painted on the water.
+    For instance, if a wall/floor is to the left of this tile, the painter
+    will select a tile that has shading on the left to make the shadow appear
+    """
+
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        dist = self._distance_to_closest(dungeon_tilemap, pos)
+        if dist > (1 + 2*random_random(pos)):  # Open Sea
+            coord = random_choice([(1, k) for k in range(self.limit[0])], pos)
+        else:  # Close Sea
+            coord = random_choice([(0, k) for k in range(self.limit[0])], pos)
+        return coord
+
+    def _distance_to_closest(self, dungeon_tilemap: DungeonTileMap, pos: tuple) -> float:
+        min_distance = 99
+        for other_pos in dungeon_tilemap.terrain_grid.keys():
+            if dungeon_tilemap.get_terrain(other_pos) != Terrain.WATER:
+                distance = utils.distance(pos, other_pos)
+                if distance < min_distance:
+                    min_distance = distance
+        return min_distance
+
+    @staticmethod
+    def is_column_bottom(dungeon_tilemap: DungeonTileMap, pos: Pos) -> bool:
+        """
+        Returns whether the position is the bottom of a wall column
+        """
+        north, _, _, _ = dungeon_tilemap.get_cardinal_terrain(pos)
+        if north == Terrain.WALL_BOTTOM and WallBottomPainter.is_a_column(dungeon_tilemap, (pos[0], pos[1] - 1)):
+            return True
+        return False
+
+    @staticmethod
+    def get_pillar_coord(dungeon_tilemap: DungeonTileMap, pos: Pos):
+        return None
+
+    @staticmethod
+    def get_shading(dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[bool, bool, bool]:
+        north, _, _, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        top, left, column = False, False, False
+
+        if north and north != Terrain.WATER:
+            top = True
+        if west and west != Terrain.WATER:
+            left = True
+        if WaterPainter.is_column_bottom(dungeon_tilemap, pos):
+            column = True
+        return top, left, column
+
+    def get_shading_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        top, left, column = WaterPainter.get_shading(dungeon_tilemap, pos)
+
+        shading_coord = None
+        if column and left:
+            shading_coord = (4, 0)
+        elif column:
+            shading_coord = (3, 0)
+        elif top and left:
+            shading_coord = (2, 0)
+        elif left:
+            shading_coord = (0, 0)
+        elif top:
+            shading_coord = (1, 0)
+
+        return shading_coord
+
+class WaterBridgePainter(Painter):
+    def get_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        coord = random_choice([(0, k) for k in range(self.limit[0])], pos)
+        return coord
+
+    @staticmethod
+    def get_shading(dungeon_tilemap: DungeonTileMap, pos: Pos) -> Tuple[bool, bool, bool]:
+        _, _, _, west = dungeon_tilemap.get_cardinal_terrain(pos)
+        left = False
+
+        if west not in (Terrain.WATER, Terrain.WATERBRIDGE, Terrain.FLOOR_LOWER, Terrain.FLOOR_UPPER):
+            left = True
+        return left
+
+    def get_shading_coord(self, dungeon_tilemap: DungeonTileMap, pos: Pos) -> Pos:
+        left = WaterBridgePainter.get_shading(dungeon_tilemap, pos)
+
+        shading_coord = None
+        if left:
+            shading_coord = (1, 0)
+
+        return shading_coord
diff --git a/app/dungeon_maker/palette.py b/app/dungeon_maker/palette.py
new file mode 100644
index 000000000..f172a2991
--- /dev/null
+++ b/app/dungeon_maker/palette.py
@@ -0,0 +1,25 @@
+import json
+
+# Floor types:
+# default
+# grass
+# ruins
+# checkerboard
+
+class Palette:
+    def __init__(self):
+        self.floor1: str = "default"
+        self.floor2: str = "default"
+        self.water: bool = False
+        self.location: str = None
+
+    @classmethod
+    def from_json(cls, fn: str) -> "Palette":
+        with open(fn) as fp:
+            data = json.load(fp)
+        self = cls()
+        self.floor1 = data['floor1']
+        self.floor2 = data['floor2']
+        self.location = data.get('location', None)
+        self.water = data.get('water', False)
+        return self
