-            action.do(action.Warp(unit, position))
-        elif movement_type == 'swoosh':
-            action.do(action.Swoosh(unit, position))
-        elif movement_type == 'fade':
-            action.do(action.FadeMove(unit, position))
-        elif movement_type == 'normal':
