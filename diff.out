+    unit = self._get_unit(global_unit)
+    if not unit:
+        self.logger.error("Couldn't find unit with nid %s" % global_unit)
+        return
+    skill_nid = skill
+    if skill_nid not in [skill.nid for skill in unit.skills]:
+        self.logger.error("Couldn't find skill with nid %s" % skill)
