+from dataclasses import dataclass
+from typing import List, Set, Tuple
+
+@dataclass(eq=False)
+class RoomPrefab:
+    x: int = 0  # Topleft of Floor
+    y: int = 0  # Topright of Floor
+    width: int = 0  # Width of Floor
+    height: int = 0  # Height of Floor
+
+    def overlaps(self, other) -> bool:
+        if self.x - 1 < other.x + other.width and \
+                self.x + self.width + 1 > other.x and \
+                self.y - 1 < other.y + other.height and \
+                self.y + self.height + 1 > other.y:
+            return True
+        else:
+            return False
+
+@dataclass(eq=False)
+class Room:
+    tiles: Set[tuple] = None
+    wall_tiles: Set[tuple] = None
+    prefab: RoomPrefab = None
+
+    @classmethod
+    def from_prefab(cls, prefab, tilemap):
+        new_room = Room(set(), set(), prefab)
+        for x in range(prefab.x, prefab.x + prefab.width):
+            for y in range(prefab.y, prefab.y + prefab.height):
+                if tilemap.check_bounds(x, y):
+                    new_room.tiles.add((x, y))
+        new_room.wall_tiles = new_room.get_wall_tiles(tilemap)
+        return new_room
+
+    def get_wall_tiles(self, tilemap) -> Set[tuple]:
+        wall_tiles = set()
+        # Left wall
+        for y in range(-1, self.prefab.height + 1):
+            wall_tiles.add((self.prefab.x - 1, self.prefab.y + y))
+        # Right wall
+        for y in range(-1, self.prefab.height + 1):
+            wall_tiles.add((self.prefab.x + self.prefab.width, self.prefab.y + y))
+        # Top wall
+        for x in range(-1, self.prefab.width + 1):
+            wall_tiles.add((self.prefab.x + x, self.prefab.y - 1))
+        # Bottom wall
+        for x in range(-1, self.prefab.width + 1):
+            wall_tiles.add((self.prefab.x + x, self.prefab.y + self.prefab.height))
+        return {tile for tile in wall_tiles if tilemap.check_bounds(*tile)}
+
+    def get_walls(self, tilemap) -> List[List[Tuple[int, int]]]:
+        # Returns a list of the walls North, East, South, West
+        # North wall
+        north_wall = [(self.prefab.x + x, self.prefab.y - 1) for x in range(0, self.prefab.width)]
+        north_wall = [tile for tile in north_wall if tilemap.check_bounds(*tile)]
+        # East wall
+        east_wall = [(self.prefab.x + self.prefab.width, self.prefab.y + y) for y in range(0, self.prefab.height)]
+        east_wall = [tile for tile in east_wall if tilemap.check_bounds(*tile)]
+        # South wall
+        south_wall = [(self.prefab.x + x, self.prefab.y + self.prefab.height) for x in range(0, self.prefab.width)]
+        south_wall = [tile for tile in south_wall if tilemap.check_bounds(*tile)]
+        # West wall
+        west_wall = [(self.prefab.x - 1, self.prefab.y + y) for y in range(0, self.prefab.height)]
+        west_wall = [tile for tile in west_wall if tilemap.check_bounds(*tile)]
+
+        return [north_wall, east_wall, south_wall, west_wall]
+
+    @property
+    def width(self):
+        return self.prefab.width
+
+    @property
+    def height(self):
+        return self.prefab.height
+
+@dataclass(eq=False)
+class Area:
+    tiles: Set[tuple] = None
+
+    @property
+    def x(self) -> float:
+        # returns the center of the room in the x direction
+        return sum(tile[0] for tile in self.tiles) / len(self.tiles)
+
+    @property
+    def y(self) -> float:
+        # returns the center of the room in the y direction
+        return sum(tile[1] for tile in self.tiles) / len(self.tiles)
+
+    @property
+    def size(self):
+        return len(self.tiles)
+
+    @property
+    def width(self):
+        return max(tile[0] for tile in self.tiles) - min(tile[0] for tile in self.tiles) + 1
+
+    @property
+    def height(self):
+        return max(tile[1] for tile in self.tiles) - min(tile[1] for tile in self.tiles) + 1
+    
+def print_rooms(rooms: List[Room]):
+    # Print rooms
+    all_positions = {}
+    for idx, room in enumerate(rooms):
+        all_positions.update({pos: idx for pos in room.tiles})
+    width = max(pos[0] for pos in all_positions.keys()) + 1
+    height = max(pos[1] for pos in all_positions.keys()) + 1
+    for y in range(height):
+        print("%02d " % y, end='')
+        for x in range(width):
+            if (x, y) in all_positions:
+                print("%d" % (all_positions[(x, y)] % 10), end='')
+            else:
+                print(" ", end='')
+        print("\n", end='')
+
+def print_room_prefabs(rooms, width, height):
+    for y in range(height):
+        print("%02d " % y, end='')
+        for x in range(width):
+            for idx, room in enumerate(rooms[:10]):
+                if (int(room.x - room.width/2) == x and room.y - room.height/2 <= y <= room.y + room.height/2) or \
+                   (int(room.x + room.width/2) == x and room.y - room.height/2 <= y <= room.y + room.height/2) or \
+                   (int(room.y - room.height/2) == y and room.x - room.width/2 <= x <= room.x + room.width/2) or \
+                   (int(room.y + room.height/2) == y and room.x - room.width/2 <= x <= room.x + room.width/2):
+                    print("%1d" % idx, end='')
+                    break
+            else:
+                print(" ", end='')
+        print("\n", end='')
diff --git a/app/old_dungeon_maker/terrain_maker.py b/app/old_dungeon_maker/terrain_maker.py
new file mode 100644
index 000000000..5e25912cd
--- /dev/null
+++ b/app/old_dungeon_maker/terrain_maker.py
@@ -0,0 +1,559 @@
+import json
+import os
+import random
+
+from app.constants import TILEWIDTH, TILEHEIGHT
+from app.engine import engine
+from app.map_maker import simplex_noise
+from app.utilities import utils, static_random
+
+def random_choice(choices: list, pos: tuple, seed: int = None, offset: int = 0):
+    if seed is None:
+        seed = static_random.get_seed()
+    random.seed(seed + pos[0] * 1024**2 + pos[1] * 1024 + offset)
+    return random.choice(choices)
+
+class Terrain():
+    base_coord = (0, 0)
+
+    def __init__(self, tileset_image_fn):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+
+    def _find_limit(self, idx: int, width: int = TILEWIDTH, height: int = TILEHEIGHT) -> int:
+        bg_color = (0, 0, 0)
+        x = idx * width
+        for y in range(0, self.tileset_image.get_height(), height):
+            current_color = self.tileset_image.get_at((x, y))
+            if current_color[:3] == bg_color[:3]:
+                return y // height
+        return self.tileset_image.get_height() // height
+
+    def single_process(self, tilemap) -> None:
+        pass
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        return self.get_image16(self.tileset_image, self.base_coord)
+
+    def get_image8(self, base_image, tile_coord) -> engine.Surface:
+        im = engine.subsurface(base_image, (
+            tile_coord[0] * TILEWIDTH//2,
+            tile_coord[1] * TILEHEIGHT//2,
+            TILEWIDTH//2, TILEHEIGHT//2))
+        return im.copy()
+
+    def get_image16(self, base_image, tile_coord) -> engine.Surface:
+        im = engine.subsurface(base_image, (
+            tile_coord[0] * TILEWIDTH,
+            tile_coord[1] * TILEHEIGHT,
+            TILEWIDTH, TILEHEIGHT))
+        return im.copy()
+
+class SimpleTerrain(Terrain):
+    def __init__(self, tileset_image_fn):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.limits = {k: self._find_limit(k) for k in range(1)}
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        coord = random_choice([(0, k) for k in range(self.limits[0])], pos)
+        return self.get_image16(self.tileset_image, coord)
+
+class WangEdge2Terrain16(Terrain):
+    def __init__(self, tileset_image_fn):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.limits = {k: self._find_limit(k) for k in range(16)}
+
+    def _determine_index(self, tilemap, pos: tuple) -> tuple:
+        north, east, south, west = tilemap.get_cardinal_terrain(pos)
+        north_edge = bool(not north or north in self.terrain_like)
+        south_edge = bool(not south or south in self.terrain_like)
+        east_edge = bool(not east or east in self.terrain_like)
+        west_edge = bool(not west or west in self.terrain_like)
+        index = 1 * north_edge + 2 * east_edge + 4 * south_edge + 8 * west_edge
+        return index
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        index = self._determine_index(tilemap, pos)
+        coord = random_choice([(index, k) for k in range(self.limits[index])], pos)
+        return self.get_image16(self.tileset_image, coord)
+
+class WangCorner2Terrain16(WangEdge2Terrain16):
+    def _determine_index(self, tilemap, pos: tuple) -> tuple:
+        northeast, southeast, southwest, northwest = tilemap.get_diagonal_terrain(pos)
+        northeast_edge = bool(not northeast or northeast in self.terrain_like)
+        southeast_edge = bool(not southeast or southeast in self.terrain_like)
+        northwest_edge = bool(not northwest or northwest in self.terrain_like)
+        southwest_edge = bool(not southwest or southwest in self.terrain_like)
+        index = 1 * northeast_edge + \
+            2 * southeast_edge + \
+            4 * southwest_edge + \
+            8 * northwest_edge
+        return index
+
+class FloorTerrain(Terrain):
+    """
+    # Implements default 16x16 Floor
+    """
+    terrain_like = ('Floor', )
+
+    def __init__(self, tileset_image_fn, shading_image_fn, offset=0):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        self.limits = {k: self._find_limit(k) for k in range(1)}
+        self.offset = offset
+
+    def _get_floor_shading(self, tilemap, pos, database, pillar=True) -> tuple:
+        north, _, _, west = tilemap.get_cardinal_terrain(pos)
+        _, _, _, northwest = tilemap.get_diagonal_terrain(pos)
+        top, left, corner = False, False, False
+
+        if north == 'Wall':
+            top = True
+        if west == 'Wall':
+            left = True
+        if northwest == 'Pillar' and pillar:
+            corner = True
+        if west == 'Pillar' and pillar:
+            left = True
+        if west and west == 'StairsLeft' and northwest == 'Wall':
+            corner = True
+        if northwest == 'Wall' and west and west.startswith('Floor') \
+                and self._is_column_bottom(tilemap, (pos[0] - 1, pos[1]), database):
+            corner = True
+
+        shading_coord = None
+        if top and left:
+            shading_coord = (3, 0)
+        elif top and corner:
+            shading_coord = (4, 0)
+        elif left:
+            shading_coord = (0, 0)
+        elif corner:
+            shading_coord = (2, 0)
+        elif top:
+            shading_coord = (1, 0)
+
+        return shading_coord
+
+    def _is_column_bottom(self, tilemap, pos: tuple, database) -> bool:
+        north, _, _, _ = tilemap.get_cardinal_terrain(pos)
+        if north and north == 'Wall':
+            north_pos = (pos[0], pos[1] - 1)
+            nn_pos = (pos[0], pos[1] - 2)
+            terrain_nid = tilemap.get_terrain(north_pos)
+            terrain = database.get(terrain_nid)
+            return terrain.wall_grid.get(nn_pos) == 'Top' and \
+                terrain.get_top_coord(tilemap, nn_pos)[0] == 0
+        return False
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        coord = random_choice([(0, k) for k in range(self.limits[0])], pos)
+        shading_coord = self._get_floor_shading(tilemap, pos, database)
+
+        base_image = self.get_image16(self.tileset_image, coord)
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = self.get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        north, _, _, _ = tilemap.get_cardinal_terrain(pos)
+        if north and north.startswith('Pillar'):
+            extra_image = self.get_image16(self.shading_image, (5, 0))
+        # column bottom
+        elif self._is_column_bottom(tilemap, pos, database):
+            extra_image = self.get_image16(self.shading_image, (6, 0))
+
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+
+        return base_image
+
+class FloorRuinsTerrain(FloorTerrain):
+    """
+    # Implements 16x16 Floor with Ruins
+    """
+    noise_vertices: dict = {}
+    noise_threshold: float = 0.5
+
+    def __init__(self, tileset_image_fn, shading_image_fn, offset=0):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        self.limits = {k: self._find_limit(k) for k in range(16)}
+        self.offset = offset
+
+    def single_process(self, tilemap):
+        # Generate a noise map and use that to fill the noise_vertices with True or False
+        # depending on threshold
+        seed = static_random.get_seed()
+        noise_map: dict = simplex_noise.gen_noise_map(
+            (tilemap.width * 2 + 1, tilemap.height * 2 + 1), seed,
+            starting_frequency=0.125)
+        self.noise_vertices = {pos: value > self.noise_threshold for pos, value in noise_map.items()}
+
+    def _determine_index(self, tilemap, pos):
+        center = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 1), False) 
+        north = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2), False)
+        east = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 1), False)
+        south = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 2), False)
+        west = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 1), False)
+        northwest = self.noise_vertices.get((pos[0]*2, pos[1]*2), False)
+        northeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2), False)
+        southwest = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 2), False)
+        southeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 2), False)
+
+        topleft = center + north + west + northwest >= 3
+        topright = center + north + east + northeast >= 3
+        bottomleft = center + south + west + southwest >= 3
+        bottomright = center + south + east + southeast >= 3
+
+        index = 1 * topright + \
+            2 * bottomright + \
+            4 * bottomleft + \
+            8 * topleft
+        return index
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        index = self._determine_index(tilemap, pos)
+        coord = random_choice([(index, k) for k in range(self.limits[index])], pos)
+        
+        shading_coord = self._get_floor_shading(tilemap, pos, database)
+
+        base_image = self.get_image16(self.tileset_image, coord)
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = self.get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        north, _, _, _ = tilemap.get_cardinal_terrain(pos)
+        if north and north.startswith('Pillar'):
+            extra_image = self.get_image16(self.shading_image, (5, 0))
+        # column bottom
+        elif self._is_column_bottom(tilemap, pos, database):
+            extra_image = self.get_image16(self.shading_image, (6, 0))
+
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+
+        return base_image
+
+class FloorGrassTerrain(FloorRuinsTerrain):
+    """
+    # Implements 8x8 Floor with Grass
+    """
+    noise_vertices: dict = {}
+    noise_threshold: float = 0.55
+
+    def __init__(self, tileset_image_fn, shading_image_fn, offset=0):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        self.limits = {k: self._find_limit(k, 8, 8) for k in range(16)}
+        self.offset = offset
+
+    def _determine_index(self, tilemap, pos):
+        center = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 1), False) 
+        north = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2), False)
+        east = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 1), False)
+        south = self.noise_vertices.get((pos[0]*2 + 1, pos[1]*2 + 2), False)
+        west = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 1), False)
+        northwest = self.noise_vertices.get((pos[0]*2, pos[1]*2), False)
+        northeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2), False)
+        southwest = self.noise_vertices.get((pos[0]*2, pos[1]*2 + 2), False)
+        southeast = self.noise_vertices.get((pos[0]*2 + 2, pos[1]*2 + 2), False)
+
+        # Topleft
+        index1 = 1 * north + \
+            2 * center + \
+            4 * west + \
+            8 * northwest
+        # Topright
+        index2 = 1 * northeast + \
+            2 * east + \
+            4 * center + \
+            8 * north
+        # Bottomright
+        index3 = 1 * east + \
+            2 * southeast + \
+            4 * south + \
+            8 * center
+        # Bottomleft
+        index4 = 1 * center + \
+            2 * south + \
+            4 * southwest + \
+            8 * west
+        return index1, index2, index3, index4
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        index1, index2, index3, index4 = self._determine_index(tilemap, pos)
+        coord1 = random_choice([(index1, k) for k in range(self.limits[index1])], (pos[0] * 2, pos[1] * 2))
+        coord2 = random_choice([(index2, k) for k in range(self.limits[index2])], (pos[0] * 2 + 1, pos[1] * 2))
+        coord3 = random_choice([(index3, k) for k in range(self.limits[index3])], (pos[0] * 2 + 1, pos[1] * 2 + 1))
+        coord4 = random_choice([(index4, k) for k in range(self.limits[index4])], (pos[0] * 2, pos[1] * 2 + 1))
+        
+        shading_coord = self._get_floor_shading(tilemap, pos, database, pillar=False)
+
+        base_image = engine.create_surface((16, 16))
+        base_image.blit(self.get_image8(self.tileset_image, coord1), (0, 0))
+        base_image.blit(self.get_image8(self.tileset_image, coord2), (8, 0))
+        base_image.blit(self.get_image8(self.tileset_image, coord3), (8, 8))
+        base_image.blit(self.get_image8(self.tileset_image, coord4), (0, 8))
+
+        shading_image = None
+        if shading_coord is not None:
+            shading_image = self.get_image16(self.shading_image, shading_coord)
+
+        extra_image = None
+        north, _, _, _ = tilemap.get_cardinal_terrain(pos)
+        if north and north.startswith('Pillar'):
+            extra_image = self.get_image16(self.shading_image, (5, 0))
+        # column bottom
+        elif self._is_column_bottom(tilemap, pos, database):
+            extra_image = self.get_image16(self.shading_image, (6, 0))
+
+        if extra_image:
+            base_image.blit(extra_image, (0, 0))
+        if shading_image:
+            base_image.blit(shading_image, (0, 0))
+
+        return base_image
+
+class WallTerrain(WangEdge2Terrain16):
+    terrain_like = ('Wall', )
+
+    def __init__(self, tileset_image_fn):
+        super().__init__(tileset_image_fn)
+        self.wall_grid = {}
+
+    def single_process(self, tilemap) -> None:
+        all_walls = {pos for pos, terrain in tilemap.terrain_grid.items() if terrain == 'Wall'}
+
+        for pos in all_walls.copy():
+            north, east, south, west = tilemap.get_cardinal_terrain(pos)
+            if east != 'Wall' and west != 'Wall' and south != 'Wall':
+                if tilemap.calc_layer(pos) == 1 and north == 'Wall':
+                    self.wall_grid[pos] = 'Bottom'
+                else:
+                    self.wall_grid[pos] = 'Top'
+                all_walls.remove(pos)
+
+        for pos in all_walls.copy():
+            south = (pos[0], pos[1] + 1)
+            if south in self.wall_grid:
+                self.wall_grid[pos] = 'Top'
+                all_walls.remove(pos)
+
+        for pos in all_walls.copy():
+            north = (pos[0], pos[1] - 1)
+            south = (pos[0], pos[1] + 1)
+            if tilemap.get_terrain(north) == 'Wall' and tilemap.get_terrain(south) != 'Wall' and \
+                    (tilemap.get_layer(pos) == 1 or tilemap.get_layer(south) == 1):
+                self.wall_grid[pos] = 'Bottom'
+                all_walls.remove(pos)
+
+        for pos in all_walls:
+            self.wall_grid[pos] = 'Top'
+
+        # Convert pieces that are surrounded to void
+        convert_to_void = set()
+        for pos in self.wall_grid.keys():
+            if all(kind == 'Top' or not tilemap.check_bounds(*adj) for kind, adj in 
+                   zip(self.get_cardinal_wallgrid(pos) + self.get_diagonal_wallgrid(pos),
+                       utils.get_cardinal_positions(pos) + utils.get_diagonal_positions(pos))):
+                convert_to_void.add(pos)
+
+        for pos in convert_to_void:
+            self.wall_grid[pos] = 'Void'
+
+    def get_cardinal_wallgrid(self, pos: tuple) -> tuple:
+        return list(self.wall_grid.get(adj, None) for adj in utils.get_cardinal_positions(pos))
+
+    def get_diagonal_wallgrid(self, pos: tuple) -> tuple:
+        return list(self.wall_grid.get(adj, None) for adj in utils.get_diagonal_positions(pos))
+
+    def get_top_coord(self, tilemap, pos: tuple) -> tuple:
+        north, east, south, west = tilemap.get_cardinal_terrain(pos)
+        nwall, ewall, swall, wwall = self.get_cardinal_wallgrid(pos)
+        newall, sewall, swwall, nwwall = self.get_diagonal_wallgrid(pos)
+        # Edge is true when we have an adjacent walllike
+        north_edge = bool(north in self.terrain_like and nwall not in ('Bottom', 'Void'))
+        south_edge = bool(south in self.terrain_like and swall not in ('Bottom', 'Void'))
+        east_edge = bool(east in self.terrain_like and ewall not in ('Bottom', 'Void'))
+        west_edge = bool(west in self.terrain_like and wwall not in ('Bottom', 'Void'))
+        index = 1 * north_edge + 2 * east_edge + 4 * south_edge + 8 * west_edge
+        coord = random_choice([(index, k) for k in range(self.limits[index])], pos)
+
+        if index in (12, 13) and swwall == 'Top':
+            coord = (15, 5)
+        elif index in (6, 7) and sewall == 'Top':
+            coord = (15, 4)
+        elif index in (14, 15) and sewall == 'Top' and swwall == 'Top':
+            coord = (15, 3) 
+        return coord
+
+    def _determine_sprite_coord(self, tilemap, pos: tuple) -> tuple:
+        north, east, south, west = tilemap.get_cardinal_terrain(pos)
+        northeast, southeast, southwest, northwest = tilemap.get_diagonal_terrain(pos)
+
+        # Check if we are in a layer 1 room and need to display the lower portion of the wall
+        if self.wall_grid[pos] == 'Bottom':
+            left, right, shadow = True, True, False
+            if west in self.terrain_like and southwest not in self.terrain_like:
+                left = False
+            if east in self.terrain_like and southeast not in self.terrain_like:
+                right = False
+            if southwest in self.terrain_like or southwest == 'Pillar':
+                shadow = True
+
+            if left and right:
+                north_pos = (pos[0], pos[1] - 1)
+                if self.wall_grid.get(north_pos) == 'Top' and self.get_top_coord(tilemap, north_pos)[0] == 0:
+                    coord = (6, 5)
+                elif shadow:
+                    coord = (5, 5)
+                else:
+                    coord = (0, 5)
+            elif left:
+                if shadow:
+                    coord = (4, 5)
+                else:
+                    coord = (1, 5)
+            elif right:
+                coord = (2, 5)
+            else:
+                coord = (3, 5)
+
+        elif self.wall_grid[pos] == 'Top': # Display the normal upper portion of the wall
+            coord = self.get_top_coord(tilemap, pos)
+
+        elif self.wall_grid[pos] == 'Void':
+            coord = (15, 2)
+
+        else:
+            raise Exception("Wall was not correctly processed: %s" % pos)
+        return coord
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        coord = self._determine_sprite_coord(tilemap, pos)
+        return self.get_image16(self.tileset_image, coord)
+
+class StairsUpDownTerrain(Terrain):
+    terrain_like = ('StairsUpDown', )
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        _, east, _, west = tilemap.get_cardinal_terrain(pos)
+        left, right = False, False
+        if east not in self.terrain_like:
+            right = True
+        if west not in self.terrain_like:
+            left = True
+
+        if left and right:
+            coord = 0, 0
+        elif left:
+            coord = 1, 0
+        elif right:
+            coord = 2, 0
+        else:
+            coord = 3, 0 
+
+        return self.get_image16(self.tileset_image, coord)
+
+class StairsLeftTerrain(Terrain):
+    terrain_like = ('StairsLeft', )
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        north, _, south, _ = tilemap.get_cardinal_terrain(pos)
+        top = False
+        if north not in self.terrain_like:
+            top = True
+
+        if top:
+            coord = 0, 0
+        else:
+            coord = 1, 0
+
+        return self.get_image16(self.tileset_image, coord)
+
+class StairsRightTerrain(StairsLeftTerrain):
+    terrain_like = ('StairsRight', )
+
+class PillarTerrain(Terrain):
+    terrain_like = ('Pillar', )
+
+    def __init__(self, tileset_image_fn, shading_image_fn):
+        self.tileset_image = engine.image_load(tileset_image_fn)
+        self.shading_image = engine.image_load(shading_image_fn)
+        self.limits = {k: self._find_limit(k) for k in range(1)}
+
+    def determine_sprite(self, tilemap, pos: tuple, database) -> engine.Surface:
+        coord = random_choice([(0, k) for k in range(self.limits[0])], pos)
+        base_image = self.get_image16(self.tileset_image, coord)
+
+        north, _, _, west = tilemap.get_cardinal_terrain(pos)
+        _, _, _, northwest = tilemap.get_diagonal_terrain(pos)
+        top, left, corner = False, False, False
+
+        if north == 'Wall':
+            top = True
+        if west == 'Wall':
+            left = True
+        if west and west.startswith('Stairs') and northwest == 'Wall':
+            corner = True
+        
+        shading_coord = None
+        if top and left:
+            shading_coord = (3, 0)
+        elif top and corner:
+            shading_coord = (4, 0)
+        elif left:
+            shading_coord = (0, 0)
+        elif corner:
+            shading_coord = (2, 0)
+        elif top:
+            shading_coord = (1, 0)
+
+        if shading_coord:
+            shading_image = self.get_image16(self.shading_image, shading_coord)
+            base_image.blit(shading_image, (0, 0))
+        return base_image
+
+def get_terrain(palette: str):
+    palette_dir = 'app/dungeon_maker/palettes/'
+    if os.path.isdir(palette_dir + palette):
+        palette_dir = palette_dir + palette
+    else:
+        palette_dir = palette_dir + 'dungeon'
+    # Interrogate palette data
+    data = {}
+    with open(os.path.join(palette_dir, 'metadata.json')) as load_file:
+        data = json.load(load_file)
+
+    floor1 = data.get('floor1', 'default')
+    floor2 = data.get('floor2', 'default')
+    water = data.get('water', False)
+
+    if floor1 == 'ruins':
+        floor1_terrain = FloorRuinsTerrain(os.path.join(palette_dir, 'floor1_ruins.png'), os.path.join(palette_dir, 'floor1_shading.png'))
+    elif floor1 == 'grass':
+        floor1_terrain = FloorGrassTerrain(os.path.join(palette_dir, 'floor1_grass.png'), os.path.join(palette_dir, 'floor1_shading.png'))
+    else:
+        floor1_terrain = FloorTerrain(os.path.join(palette_dir, 'floor1.png'), os.path.join(palette_dir, 'floor1_shading.png'))
+
+    if floor2 == 'ruins':
+        floor2_terrain = FloorRuinsTerrain(os.path.join(palette_dir, 'floor2_ruins.png'), os.path.join(palette_dir, 'floor2_shading.png'), 1)
+    elif floor2 == 'grass':
+        floor2_terrain = FloorGrassTerrain(os.path.join(palette_dir, 'floor2_grass.png'), os.path.join(palette_dir, 'floor2_shading.png'), 1)
+    else:
+        floor2_terrain = FloorTerrain(os.path.join(palette_dir, 'floor2.png'), os.path.join(palette_dir, 'floor2_shading.png'), 1)
+
+    return {'Floor': floor1_terrain,
+            'Floor2': floor2_terrain,
+            'Wall': WallTerrain(os.path.join(palette_dir, 'wall.png')),
+            'Pillar': PillarTerrain(os.path.join(palette_dir, 'pillar1.png'), os.path.join(palette_dir, 'floor1_shading.png')),
+            'Pillar2': PillarTerrain(os.path.join(palette_dir, 'pillar2.png'), os.path.join(palette_dir, 'floor2_shading.png')),
+            'StairsUpDown': StairsUpDownTerrain(os.path.join(palette_dir, 'stairs_updown.png')),
+            'StairsLeft': StairsLeftTerrain(os.path.join(palette_dir, 'stairs_left.png')),
+            'StairsRight': StairsRightTerrain(os.path.join(palette_dir, 'stairs_right.png')),
+            }
diff --git a/app/old_dungeon_maker/wave_function_collapse.py b/app/old_dungeon_maker/wave_function_collapse.py
new file mode 100644
index 000000000..2531e7347
--- /dev/null
+++ b/app/old_dungeon_maker/wave_function_collapse.py
@@ -0,0 +1,373 @@
+import math, random
+from collections import Counter
+
+from app.engine import engine
+
+from typing import List, Dict, Tuple, Set, Callable
+
+Point = Tuple[int, int]
+Color3 = Tuple[int, int, int]
+PatternHash = int
+
+direction_offsets = [(0, -1), (1, 0), (0, 1), (-1, 0)]
+
+class Contradiction(Exception):
+    """Solver could not proceed."""
+    pass
+
+class TimedOut(Exception):
+    """
+    Solver ran out of attempts
+    """
+    pass
+
+def shannon_entropy(weights: List[int]) -> float:
+    """
+    Returns the entropy of the given list of weights
+    1 is highly entropic and random
+    0 is a single settled possibility
+    """
+    assert(len(weights) > 0)
+    n = sum(weights)
+    assert(n > 0)
+    probabilities = [weight / n for weight in weights]
+    log_probabilities = [math.log2(_) for _ in probabilities]
+    total = sum([a * b for a, b in zip(probabilities, log_probabilities)])
+    constant = -1 / math.log2(n)
+    h = constant * total
+    assert(0 <= h <= 1)
+    return h
+
+def read_image(image_fn: str) -> Tuple[engine.Surface, Tuple[int, int]]:
+    im = engine.image_load(image_fn)
+    im_size = im.get_width(), im.get_height()
+    return im, im_size
+
+def make_tile_catalog(image: engine.Surface, image_size: Tuple[int, int]) -> Tuple[Dict[Point, Color3], List[Color3], Dict[Color3, int]]:
+    """
+    Takes an image and returns the following
+    tile_grid is dictionary of the original image
+    code_list is the original image in 1 dimension list
+    unique_tiles is the set of tiles, plus the frequency of their occurence
+    """
+    width, height = image_size
+
+    tile_grid = {}
+    code_list = []
+    for x in range(width):
+        for y in range(height):
+            r, g, b, _ = image.get_at((x, y))
+            tile_grid[(x, y)] = (r, g, b)
+            code_list.append((r, g, b))
+
+    unique_tiles = Counter()
+    for color in code_list:
+        unique_tiles[color] += 1
+    
+    return tile_grid, code_list, unique_tiles
+
+def hash_pattern(pattern: List[Color3]) -> int:
+    return hash(tuple(pattern))
+
+def get_offsets(ksize: int) -> List[Point]:
+    return [(x, y) for y in range(ksize) for x in range(ksize)]  
+
+def make_pattern_catalog(tile_grid: Dict[Point, Color3], ksize: int, im_size: Tuple[int, int]) -> Tuple[Dict[PatternHash, List[Color3]], Dict[PatternHash, int]]:
+    """
+    Returns a pattern catalog (dictionary of pattern hashes to constituent tiles),
+    pattern weights (dictionary of pattern hashes to incidence)
+    """
+
+    width, height = im_size
+    patterns = {}
+    pattern_incidence = Counter()
+    for x in range(width):
+        for y in range(height):
+            pattern = []
+            for kx, ky in get_offsets(ksize):
+                point = (x + kx) % width, (y + ky) % height  # mod so it wraps
+                pattern.append(tile_grid[point])
+            pattern_hash = hash_pattern(pattern)
+            patterns[pattern_hash] = pattern
+            pattern_incidence[pattern_hash] += 1
+    return patterns, pattern_incidence
+
+def adjacency_extraction(patterns: Dict[PatternHash, List[Color3]], pattern_size: int) -> List[Tuple[Point, int, int]]:
+    """
+    Take a pattern grid and return a list of legal adjacencies found in it
+    """
+
+    def is_valid_overlap(adjacency_direction: Point, pattern1: int, pattern2: int) -> bool:
+        actual_pattern1: List[Color3] = patterns[pattern1]
+        actual_pattern2: List[Color3] = patterns[pattern2]
+
+        offsets = get_offsets(pattern_size)
+        if adjacency_direction == (-1, 0):
+            pattern_match1 = lambda offset: offset[0] != pattern_size - 1
+            pattern_match2 = lambda offset: offset[0] != 0
+        elif adjacency_direction == (1, 0):
+            pattern_match1 = lambda offset: offset[0] != 0
+            pattern_match2 = lambda offset: offset[0] != pattern_size - 1
+        elif adjacency_direction == (0, -1):
+            pattern_match1 = lambda offset: offset[1] != pattern_size - 1
+            pattern_match2 = lambda offset: offset[1] != 0
+        elif adjacency_direction == (0, 1):
+            pattern_match1 = lambda offset: offset[1] != 0
+            pattern_match2 = lambda offset: offset[1] != pattern_size - 1
+
+        adjacent1 = [actual_pattern1[idx] for idx, offset in enumerate(offsets) if 
+                     pattern_match1(offset)]
+        assert len(adjacent1) == pattern_size**2 - pattern_size, "%d %d" % (len(adjacent1), pattern_size)
+        # Make negative to account for opposite direction
+        adjacent2 = [actual_pattern2[idx] for idx, offset in enumerate(offsets) if 
+                     pattern_match2(offset)]
+        assert len(adjacent2) == pattern_size**2 - pattern_size, "%d %d" % (len(adjacent1), pattern_size)
+        for adj1, adj2 in zip(adjacent1, adjacent2):
+            if adj1 != adj2:
+                return False
+        return True
+
+    pattern_list = list(patterns.keys())
+    legal = []
+    for pattern1 in pattern_list:
+        for pattern2 in pattern_list:
+            for direction in direction_offsets:
+                if is_valid_overlap(direction, pattern1, pattern2):
+                    legal.append((direction, pattern1, pattern2))
+    return legal
+
+class Solver:
+    def __init__(self, wave: Dict[Point, Set[PatternHash]], 
+                 adj: Dict[Point, Dict[PatternHash, Set[PatternHash]]],
+                 pattern_incidence: Dict[PatternHash, int],
+                 render_intermediate: Callable):
+        self.wave = wave
+        self.adj = adj
+        self.pattern_incidence = pattern_incidence
+        self.render_intermediate = render_intermediate
+        self.counter = 0
+
+        self.coords = list(self.wave.keys())
+        random.shuffle(self.coords)
+
+    @property
+    def is_solved(self) -> bool:
+        return all(len(possibilities) == 1 for possibilities in self.wave.values())
+
+    def solve_next(self) -> bool:
+        if self.is_solved:
+            return True
+        # Only needs to be done once
+        if self.counter == 0:
+            self.propagate()
+            self.render_intermediate(self.wave, self.counter); self.counter += 1
+
+        try:
+            pattern, i, j = self.observe()
+            self.wave[(i, j)] = {pattern}
+            # self.print_wave()
+            # self.render_intermediate(self.wave, self.counter); self.counter += 1
+            self.propagate()
+            self.render_intermediate(self.wave, self.counter); self.counter += 1
+            return False  # Assume there are remaining steps
+        except Contradiction:
+            raise
+
+    def num_possibilities(self):
+        return sum([len(possibilities) for possibilities in self.wave.values()])
+
+    def print_wave(self):
+        print([len(patterns) for coord, patterns in sorted(self.wave.items())])
+
+    def propagate(self):
+        """
+        Completely propagate any newly collapsed waves to all areas
+        """
+        last_count = self.num_possibilities()
+        print(last_count)
+
+        while True:
+            # self.print_wave()
+            # self.render_intermediate(self.wave, self.counter)
+            for coord, possibility_cell in self.wave.items():
+                for direction in self.adj:
+                    dx, dy = direction
+                    other_coord = (coord[0] + dx), (coord[1] + dy)
+                    other_cell = self.wave.get(other_coord)
+                    if other_cell is None:  # Output does not wrap, so it's possible to run into bounds
+                        continue
+                    # a = other_cell.copy()
+                    other_possibilities = set()
+                    for possibility in possibility_cell:                            
+                        valid_possibilities = self.adj[direction][possibility]
+                        other_possibilities |= valid_possibilities
+                    other_cell &= other_possibilities
+                    # if len(a) != len(other_cell):
+                    #     print(direction, coord, other_coord)
+                    #     print(len(a), "$", len(other_cell), "$", a, "$", other_cell)
+
+            if self.num_possibilities() == last_count:
+                break # No changes since the last loop, changed waves have been full propagated
+            last_count = self.num_possibilities()
+
+        if any(len(patterns) == 0 for patterns in self.wave.values()):
+            raise Contradiction("Wave is in a contradictory state and cannot be solved")
+
+        # self.print_wave()
+
+    def observe(self):
+        i, j = self.location_heuristic()
+        pattern = self.pattern_heuristic(i, j)
+        return pattern, i, j
+
+    def location_heuristic(self):
+        """
+        Returns the location with the minimum amount of entropy
+        That has more than one valid choice
+        """
+        min_entropy = 1 + .01
+        min_coord = None
+       
+        for coord in self.coords:
+            possibilities = self.wave[coord]
+            if len(possibilities) == 0:
+                raise Contradiction("Wave is in a contradictory state and cannot be solved")
+            elif len(possibilities) == 1:
+                continue  # Only one valid choice
+            incidence = [self.pattern_incidence[possibility] for possibility in possibilities]
+            entropy = shannon_entropy(incidence)
+            if entropy < min_entropy:
+                min_entropy = entropy
+                min_coord = coord
+        assert(min_coord is not None)
+        return min_coord
+
+    def pattern_heuristic(self, i: int, j: int) -> PatternHash:
+        patterns = list(self.wave[(i, j)])  # Order matters here
+        weights = [self.pattern_incidence[pattern] for pattern in patterns]
+        choice = random.choices(patterns, weights=weights)[0]
+        # print("Chosen Pattern: %s" % choice)
+        return choice
+
+def run(wave, adj, pattern_incidence, render_intermediate):
+    solver = Solver(wave, adj, pattern_incidence, render_intermediate)
+    while not solver.solve_next():
+        pass
+    return solver.wave
+
+def pattern_grid_to_tiles(solution: Dict[Point, Set[PatternHash]], patterns: Dict[PatternHash, List[Color3]], pattern_size: int) -> Dict[Point, Color3]:
+    tile_grid: Dict[Point, Color3] = {}
+    for coord, pattern_set in solution.items():
+        pattern: List[Color3] = patterns[next(iter(pattern_set))]
+        offsets = get_offsets(pattern_size)
+        for idx, offset in enumerate(offsets):
+            new_coord = (coord[0] + offset[0]), (coord[1] + offset[1])
+            # This section is for testing
+            if new_coord in tile_grid:
+                current_pattern: Color3 = tile_grid[new_coord]
+                if pattern[idx] != current_pattern:
+                    print("Something's gone wrong with the pattern matching...", offset)
+            # End testing
+            tile_grid[new_coord] = pattern[idx]
+    return tile_grid
+
+def color_mean(colors: List[Color3]) -> Color3:
+    num = len(colors)
+    r = int(sum(color[0] for color in colors) / num)
+    g = int(sum(color[1] for color in colors) / num)
+    b = int(sum(color[2] for color in colors) / num)
+    return (r, g, b)
+
+def render_output(tile_grid: Dict[Point, Color3], output_fn: str, output_size: Tuple[int, int]) -> None:
+    width, height = output_size
+    im = engine.create_simple_surface(output_size)
+    for x in range(width):
+        for y in range(height):
+            im.set_at((x, y), tile_grid[(x, y)])
+    engine.save_surface(im, output_fn)
+
+def get_render(patterns, pattern_size: int, 
+               output_size: Tuple[int, int],
+               output_magnification: int):
+    def render_intermediate(wave, idx: int):
+        print("Rendering: %d" % idx)
+        tile_grid: Dict[Point, List[Color3]] = {}
+        for coord, pattern_set in wave.items():
+            if coord not in tile_grid:
+                tile_grid[coord] = list()
+            for pattern in pattern_set:
+                color = patterns[pattern][0]
+                tile_grid[coord].append(color)
+
+        width, height = output_size
+        im = engine.create_simple_surface(output_size)
+        for x in range(width):
+            for y in range(height):
+                color = color_mean(tile_grid[(x, y)])
+                im.set_at((x, y), color)
+        scale = (output_magnification * width, output_magnification * height)
+        im = engine.transform_scale(im, scale)
+        engine.save_surface(im, 'app/dungeon_maker/intermediate%03d.png' % idx)
+
+    return render_intermediate
+
+def execute(image_fn: str, pattern_width: int = 2, 
+            output_size: Tuple[int, int] = (10, 10), 
+            attempt_limit: int = 10, seed=0, 
+            render_intermediate=False,
+            output_magnification=1) -> None:
+    assert pattern_width >= 2
+    random.seed(seed)
+    image, image_size = read_image(image_fn)
+    print(image_size)
+    print(get_offsets(pattern_width))
+    tile_grid, code_list, unique_tiles = make_tile_catalog(image, image_size)
+    print(len(unique_tiles))
+    patterns, pattern_incidence = make_pattern_catalog(tile_grid, pattern_width, image_size)
+    print(pattern_incidence)
+    adjacency_relations = adjacency_extraction(patterns, pattern_width)
+    number_of_patterns = len(pattern_incidence)
+    print("Number of Patterns: %d" % number_of_patterns)
+
+    if True:
+        for hs, pattern in patterns.items():
+            print(hs)
+            print(pattern)
+
+    # Set up, for each direction, which patterns connect to which patterns
+    adjacency_list: Dict[Point, Dict[PatternHash, Set[PatternHash]]] = {}
+    for direction in direction_offsets:
+        adjacency_list[direction] = {pattern: set() for pattern in pattern_incidence}
+    for direction, pattern1, pattern2 in adjacency_relations:
+        adjacency_list[direction][pattern1].add(pattern2)
+
+    if False:
+        for direction in adjacency_list:
+            for pattern1 in adjacency_list[direction]:
+                print(direction, patterns[pattern1])
+                other_patterns = [patterns[pattern2] for pattern2 in adjacency_list[direction][pattern1]]
+                print(len(other_patterns))
+                print(other_patterns)
+
+    if render_intermediate:
+        render_intermediate = get_render(patterns, pattern_width, output_size, output_magnification)
+    else:
+        render_intermediate = lambda wave, idx: 0  # Pass
+
+    attempts = 0
+    while attempts < attempt_limit:
+        attempts += 1
+        try:
+            wave: Dict[Point, Set[PatternHash]] = {(x, y): set(pattern_incidence.keys()) for x in range(output_size[0]) for y in range(output_size[1])}
+            solution = run(wave, adjacency_list, pattern_incidence, render_intermediate)
+            solution_tile_grid = pattern_grid_to_tiles(solution, patterns, pattern_width)
+            output_fn = image_fn[:-4] + "_output.png"
+            render_output(solution_tile_grid, output_fn, output_size)
+            return
+        except Contradiction:
+            print("Contradiction on attempt %d of %d" % (attempts, attempt_limit))
+
+    raise TimedOut("Attempt Limit Exceeded!")
+
+if __name__ == '__main__':
+    execute('app/dungeon_maker/wfc_input4.png', 3, (30, 30), 10, seed=0, render_intermediate=True, output_magnification=16)
