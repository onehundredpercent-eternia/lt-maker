-        except:
-            self.logger.error("Could not evaluate {%s}" % values[1])
-            return
-        if 'hidden' in flags:
-            game.current_mode.enemy_autolevels = autolevel
-        else:
-            game.current_mode.enemy_truelevels = autolevel
-
-    def promote(self, command):
