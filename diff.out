diff --git a/app/utilities/class_utils.py b/app/utilities/class_utils.py
index fbc90f719..ac3dd6211 100644
--- a/app/utilities/class_utils.py
+++ b/app/utilities/class_utils.py
@@ -1,8 +1,15 @@
-
 def recursive_subclasses(ctype: type):
     all_subclasses = []
     subclasses = ctype.__subclasses__()
     for subclass in subclasses:
         all_subclasses += recursive_subclasses(subclass)
     all_subclasses += subclasses
-    return all_subclasses
\ No newline at end of file
+    return all_subclasses
+
+class Singleton(type):
+    _instances = {}
+
+    def __call__(cls, *args, **kwargs):
+        if cls not in cls._instances:
+            cls._instances[cls] = super(Singleton, cls).__call__(*args, **kwargs)
+        return cls._instances[cls]
