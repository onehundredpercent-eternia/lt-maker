-            self.logger.error("Couldn't find subitem with nid %s" % values[2])
-            return
-        subitem = [subitem for subitem in item.subitems if subitem.nid == values[2]][0]
-        action.do(action.RemoveItemFromMultiItem(unit, item, subitem))
