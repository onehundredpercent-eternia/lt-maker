-        if len(values) > 2 and values[2]:
-            try:
-                level = int(evaluate.evaluate(values[2], self.unit, self.unit2, self.item, self.position, self.region))
-            except:
-                self.logger.error("Could not evaluate {%s}" % values[2])
-                return
