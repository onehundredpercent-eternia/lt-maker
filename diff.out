-    def update(self):
-        if self.menu:
-            self.menu.update()
-
-        if self.state == 'transition_in':
-            self.position_x += 20
-            if self.position_x >= WINWIDTH//2:
-                self.position_x = WINWIDTH//2
-                self.state = 'normal'
-
-        elif self.state == 'transition_out':
-            self.position_x -= 20
-            if self.position_x <= -WINWIDTH//2:
