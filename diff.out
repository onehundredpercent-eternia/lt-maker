--- a/app/map_maker/value_noise.py
+++ b/utilities/archived_code/value_noise.py
@@ -4,6 +4,10 @@ from app.map_maker.utilities import get_random_seed
 class ValueNoise():
     num_octaves = 3
     pixels_per_lattice = 4
+    starting_frequency = 1
+    frequency_mult = 2  # lacunarity
+    amplitude_mult = 0.5
