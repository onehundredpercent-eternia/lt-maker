+        "nid": "vendor_back",
+        "text": "Anything else I can do for you?"
+    },
+    {
+        "nid": "vendor_leave",
+        "text": "Drop in again."
+    },
+    {
+        "nid": "shop_again",
+        "text": "Do you need anything else?"
+    },
+    {
+        "nid": "shop_buy_again",
+        "text": "Buying anything else?"
+    },
+    {
+        "nid": "shop_sell_again",
+        "text": "Selling anything else?"
+    },
+    {
+        "nid": "shop_convoy",
+        "text": "Send it to your convoy?"
+    },
+    {
+        "nid": "shop_max",
+        "text": "Your hands are full. {w}{clear}If you had a convoy, I could send it there... {w}{clear}Anything else I can do for you?"
+    },
+    {
+        "nid": "shop_no_money",
+        "text": "Sorry. You don't have enough money."
+    },
+    {
+        "nid": "shop_check",
+        "text": "Are you sure?"
+    },
+    {
+        "nid": "shop_no_value",
+        "text": "You can't sell that here."
+    },
+    {
+        "nid": "config_desc",
+        "text": "Change settings."
+    },
+    {
+        "nid": "record_header",
